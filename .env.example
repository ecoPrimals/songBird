# Songbird Network Orchestrator - Environment Configuration
# Copy to .env and configure for your environment

# Core Configuration
SONGBIRD_ENV=development

# IPC Socket (XDG-compliant, domain-based per PRIMAL_SELF_KNOWLEDGE_STANDARD v1.1)
# BIOMEOS_SOCKET_DIR=/run/user/1000/biomeos
# Bound socket: $BIOMEOS_SOCKET_DIR/songbird.sock (or songbird-{family_id}.sock)
# Domain symlink (created at bind): network.sock → songbird.sock

# Multi-family support
# FAMILY_ID=nat0

# Network (see docs/ENVIRONMENT_VARIABLES.md for full reference)
# SONGBIRD_HTTP_PORT=8080
# SONGBIRD_BIND_ADDRESS=127.0.0.1
# SONGBIRD_IGD_ENABLED=true

# Security Provider (capability-based crypto delegation)
# SECURITY_PROVIDER_SOCKET=/run/user/1000/biomeos/security.sock
# Legacy fallback: BEARDOG_SOCKET=/run/user/1000/biomeos/beardog.sock

# Neural API (biomeOS)
# NEURAL_API_SOCKET=/run/user/1000/biomeos/neural-api.sock

# Mesh Discovery
# PLASMODIUM_PEERS=192.168.1.100:3492,192.168.1.101:3492
