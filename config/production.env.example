# Songbird Production Environment Configuration
# Copy to production.env and customize with production values
# DO NOT commit production.env to version control!

# Environment
export SONGBIRD_ENV=production
export SONGBIRD_LOG_LEVEL=warn

# Service Ports (Production)
export SONGBIRD_API_PORT=8080
export SONGBIRD_ADMIN_PORT=8081
export SONGBIRD_METRICS_PORT=9090
export SONGBIRD_HEALTH_PORT=8082

# Network (Bind to all interfaces in production)
export SONGBIRD_BIND_HOST=0.0.0.0
export SONGBIRD_BIND_ADDRESS=0.0.0.0:8080
export SONGBIRD_PRODUCTION_BIND_ADDRESS=0.0.0.0
export SONGBIRD_PRODUCTION_BINDING_APPROVED=true

# Timeouts (Production values)
export SONGBIRD_CONNECTION_TIMEOUT_SECS=10
export SONGBIRD_REQUEST_TIMEOUT_SECS=30
export SONGBIRD_IDLE_TIMEOUT_SECS=60

# Health Checks (Frequent in production)
export SONGBIRD_HEALTH_CHECK_INTERVAL_SECS=30
export SONGBIRD_HEALTH_CHECK_TIMEOUT_SECS=5

# Retry Configuration
export SONGBIRD_RETRY_DELAY_MS=100
export SONGBIRD_MAX_RETRY_DELAY_SECS=30
export SONGBIRD_MAX_RETRIES=3

# Discovery (Production endpoints)
export SONGBIRD_DEFAULT_DISCOVERY_ENDPOINT=http://consul.internal:8500
export SONGBIRD_DEFAULT_REGISTRY_ENDPOINT=http://registry.internal:8600

# Dashboard (Production domain)
export SONGBIRD_DASHBOARD_ORIGIN=https://dashboard.songbird.example.com
export SONGBIRD_CORS_ORIGINS=https://dashboard.songbird.example.com,https://api.songbird.example.com

# Database (Production - use secrets management!)
export SONGBIRD_DB_HOST=postgres.internal
export SONGBIRD_DB_PORT=5432
export SONGBIRD_DB_NAME=songbird_prod
export SONGBIRD_DB_USER=songbird_prod
export SONGBIRD_DB_POOL_SIZE=20

# Redis (Production)
export SONGBIRD_REDIS_HOST=redis.internal
export SONGBIRD_REDIS_PORT=6379
export SONGBIRD_REDIS_TTL_SECS=3600

# Federation (Enable in production)
export SONGBIRD_FEDERATION_ENABLED=true
export SONGBIRD_FEDERATION_NODE_ID=prod-node-1
export SONGBIRD_FEDERATION_SYNC_INTERVAL_SECS=60

# Features (Production settings)
export SONGBIRD_TRACING_ENABLED=true
export SONGBIRD_METRICS_ENABLED=true
export SONGBIRD_PROFILING_ENABLED=false

# Circuit Breaker (Production tuned)
export SONGBIRD_CIRCUIT_BREAKER_THRESHOLD=5
export SONGBIRD_CIRCUIT_BREAKER_TIMEOUT_SECS=60

echo "⚠️  Production environment configured - verify all settings!"
echo "   API: http://0.0.0.0:8080 (all interfaces)"
echo "   Metrics: http://0.0.0.0:9090"

