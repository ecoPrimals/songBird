# Songbird Environment Configuration Template
# Copy this file to development.env, staging.env, or production.env
# and customize for your environment

# ============================================================================
# CORE SERVICE PORTS
# ============================================================================
SONGBIRD_API_PORT=8080
SONGBIRD_ADMIN_PORT=8081
SONGBIRD_METRICS_PORT=9090
SONGBIRD_HEALTH_PORT=8082
SONGBIRD_WS_PORT=3000
SONGBIRD_DASHBOARD_PORT=3000

# ============================================================================
# SERVICE DISCOVERY PORTS
# ============================================================================
SONGBIRD_DISCOVERY_PORT=8500
SONGBIRD_REGISTRY_PORT=8600
SONGBIRD_ORCHESTRATOR_PORT=8700

# ============================================================================
# NETWORK BINDING
# ============================================================================
SONGBIRD_BIND_HOST=0.0.0.0
SONGBIRD_BIND_ADDRESS=0.0.0.0:8080
SONGBIRD_DEFAULT_SERVICE_HOST=localhost

# Production-specific (requires approval)
# SONGBIRD_PRODUCTION_BIND_ADDRESS=0.0.0.0
# SONGBIRD_PRODUCTION_BINDING_APPROVED=true

# ============================================================================
# TIMEOUTS & INTERVALS (in seconds unless noted)
# ============================================================================
# Connection Timeouts
SONGBIRD_CONNECTION_TIMEOUT_SECS=10
SONGBIRD_REQUEST_TIMEOUT_SECS=30
SONGBIRD_IDLE_TIMEOUT_SECS=60
SONGBIRD_KEEPALIVE_TIMEOUT_SECS=75

# Health Checks
SONGBIRD_HEALTH_CHECK_INTERVAL_SECS=30
SONGBIRD_HEALTH_CHECK_TIMEOUT_SECS=5

# Retry Configuration
SONGBIRD_RETRY_DELAY_MS=100
SONGBIRD_MAX_RETRY_DELAY_SECS=30
SONGBIRD_MAX_RETRIES=3

# Metrics & Monitoring
SONGBIRD_METRICS_INTERVAL_SECS=60
SONGBIRD_LOG_FLUSH_INTERVAL_SECS=10

# ============================================================================
# SERVICE DISCOVERY & ENDPOINTS
# ============================================================================
SONGBIRD_DEFAULT_DISCOVERY_ENDPOINT=http://localhost:8500
SONGBIRD_DEFAULT_REGISTRY_ENDPOINT=http://localhost:8600

# Dashboard & CORS
SONGBIRD_DASHBOARD_ORIGIN=http://localhost:3000
SONGBIRD_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ============================================================================
# CAPABILITY ENDPOINTS (Dynamic Discovery)
# ============================================================================
# These are discovered dynamically, but can be overridden:
# CAPABILITY_COMPUTE_ENDPOINT=http://toadstool:8080
# CAPABILITY_SECURITY_ENDPOINT=http://beardog:8443
# CAPABILITY_STORAGE_ENDPOINT=http://nestgate:9000
# CAPABILITY_AI_ENDPOINT=http://squirrel:8888

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL
SONGBIRD_DB_HOST=localhost
SONGBIRD_DB_PORT=5432
SONGBIRD_DB_NAME=songbird
SONGBIRD_DB_USER=songbird
SONGBIRD_DB_POOL_SIZE=10
SONGBIRD_DB_POOL_TIMEOUT_SECS=30

# Redis
SONGBIRD_REDIS_HOST=localhost
SONGBIRD_REDIS_PORT=6379
SONGBIRD_REDIS_TTL_SECS=3600

# ============================================================================
# FEDERATION CONFIGURATION
# ============================================================================
SONGBIRD_FEDERATION_ENABLED=false
SONGBIRD_FEDERATION_NODE_ID=node-1
SONGBIRD_FEDERATION_SYNC_INTERVAL_SECS=60

# ============================================================================
# ENVIRONMENT & DEPLOYMENT
# ============================================================================
SONGBIRD_ENV=development  # development | staging | production
SONGBIRD_LOG_LEVEL=info   # trace | debug | info | warn | error

# Port Range Configuration
SONGBIRD_PORT_START=8000
SONGBIRD_PORT_END=9000
SONGBIRD_ALLOW_PRIVILEGED_PORTS=false

# ============================================================================
# ADVANCED CONFIGURATION
# ============================================================================
# Circuit Breaker
SONGBIRD_CIRCUIT_BREAKER_THRESHOLD=5
SONGBIRD_CIRCUIT_BREAKER_TIMEOUT_SECS=60

# Load Balancing
SONGBIRD_LB_STRATEGY=round_robin  # round_robin | least_connections | random
SONGBIRD_LB_HEALTH_WEIGHT=0.7

# Caching
SONGBIRD_CACHE_TTL_SECS=300
SONGBIRD_CACHE_MAX_SIZE=10000

# ============================================================================
# OBSERVABILITY
# ============================================================================
SONGBIRD_TRACING_ENABLED=true
SONGBIRD_METRICS_ENABLED=true
SONGBIRD_PROFILING_ENABLED=false

