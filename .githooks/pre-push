#!/usr/bin/env bash
# BUILD-DIV-01 prevention: verify all targets compile before pushing.
# Catches used-but-unimplemented methods, missing test deps, and bench errors.
#
# Install: git config core.hooksPath .githooks
# Skip once: git push --no-verify

set -euo pipefail

echo "pre-push: running cargo check --all-targets..."

if ! cargo check --all-targets 2>&1; then
    echo ""
    echo "ERROR: cargo check --all-targets failed."
    echo "Fix compilation errors before pushing (BUILD-DIV-01 gate)."
    echo "To bypass once: git push --no-verify"
    exit 1
fi

echo "pre-push: all targets OK ✓"
