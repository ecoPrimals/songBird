# 🌍 Songbird Environment Configuration
# This file replaces ALL hardcoded values with environment-based configuration

# ===============================================
# 🔧 CORE NETWORK CONFIGURATION
# ===============================================

# Development bind address (replaces hardcoded 127.0.0.1)
SONGBIRD_BIND_ADDRESS=127.0.0.1

# Development port (replaces hardcoded 8080)
SONGBIRD_PORT=8080

# Production bind address (replaces hardcoded 0.0.0.0)
SONGBIRD_PRODUCTION_BIND_ADDRESS=0.0.0.0

# Production port (replaces hardcoded 80/443)
SONGBIRD_PRODUCTION_PORT=443

# Enable IPv6 support
SONGBIRD_ENABLE_IPV6=false

# ===============================================
# 🔐 SECURITY CONFIGURATION (REQUIRED)
# ===============================================

# JWT Secret for token signing (REQUIRED - generate with: openssl rand -hex 64)
SONGBIRD_JWT_SECRET=your-super-secret-jwt-key-here-change-this-in-production

# Encryption key for data protection (REQUIRED - generate with: openssl rand -hex 32)
SONGBIRD_ENCRYPTION_KEY=your-encryption-key-here-change-this-in-production

# Session timeout in hours
SONGBIRD_SESSION_TIMEOUT_HOURS=24

# Enable two-factor authentication
SONGBIRD_ENABLE_2FA=false

# ===============================================
# 🔍 SERVICE DISCOVERY CONFIGURATION
# ===============================================

# Discovery timeout in milliseconds (replaces hardcoded 30000)
SONGBIRD_DISCOVERY_TIMEOUT_MS=30000

# Enable automatic service discovery
SONGBIRD_AUTO_DISCOVERY=true

# Service registry URL (optional)
SONGBIRD_REGISTRY_URL=http://localhost:8500

# Heartbeat interval in milliseconds (replaces hardcoded 30000)
SONGBIRD_HEARTBEAT_INTERVAL_MS=30000

# ===============================================
# ⚡ PERFORMANCE CONFIGURATION
# ===============================================

# Worker threads (auto-detected from CPU cores if not set)
SONGBIRD_WORKER_THREADS=8

# Connection pool size (replaces hardcoded 100)
SONGBIRD_CONNECTION_POOL_SIZE=100

# Request timeout in milliseconds (replaces hardcoded 30000)
SONGBIRD_REQUEST_TIMEOUT_MS=30000

# Enable compression
SONGBIRD_ENABLE_COMPRESSION=true

# ===============================================
# 🎮 GAMING NETWORK CONFIGURATION
# ===============================================

# Gaming discovery ports (replaces hardcoded port ranges)
SONGBIRD_GAMING_PORTS=27015,27016,27017,7777,7778

# StarCraft II port (replaces hardcoded 1119)
SONGBIRD_STARCRAFT_PORT=1119

# Age of Empires 2 port (replaces hardcoded 2300)
SONGBIRD_AOE2_PORT=2300

# Counter-Strike port (replaces hardcoded 27015)
SONGBIRD_CS_PORT=27015

# ===============================================
# 🏭 PRIMAL ENDPOINTS (REPLACES HARDCODED PATHS)
# ===============================================

# Security primal endpoint
PRIMAL_SECURITY_ENDPOINT=http://localhost:8001

# Compute primal endpoint
PRIMAL_COMPUTE_ENDPOINT=http://localhost:8002

# Storage primal endpoint (replaces ../nestgate)
PRIMAL_STORAGE_ENDPOINT=http://localhost:8003

# AI primal endpoint
PRIMAL_AI_ENDPOINT=http://localhost:8004

# Gaming primal endpoint
PRIMAL_GAMING_ENDPOINT=http://localhost:8005

# ===============================================
# 📊 MONITORING & OBSERVABILITY
# ===============================================

# Metrics collection interval in seconds
SONGBIRD_METRICS_INTERVAL_SECS=60

# Health check interval in seconds
SONGBIRD_HEALTH_CHECK_INTERVAL_SECS=30

# Log level (trace, debug, info, warn, error)
SONGBIRD_LOG_LEVEL=info

# Enable structured logging
SONGBIRD_STRUCTURED_LOGGING=true

# ===============================================
# 🔄 FEDERATION CONFIGURATION
# ===============================================

# Federation timeout in milliseconds
SONGBIRD_FEDERATION_TIMEOUT_MS=30000

# Federation heartbeat interval
SONGBIRD_FEDERATION_HEARTBEAT_MS=15000

# Enable federation auto-discovery
SONGBIRD_FEDERATION_AUTO_DISCOVERY=true

# Federation peers (comma-separated)
SONGBIRD_FEDERATION_PEERS=

# ===============================================
# 💾 DATABASE CONFIGURATION
# ===============================================

# Database URL (replaces hardcoded connection strings)
DATABASE_URL=sqlite://./songbird.db

# Connection pool size
DATABASE_POOL_SIZE=10

# Connection timeout in seconds
DATABASE_TIMEOUT_SECS=30

# ===============================================
# 🚀 DEPLOYMENT CONFIGURATION
# ===============================================

# Environment (development, staging, production)
SONGBIRD_ENVIRONMENT=development

# Enable TLS in production
SONGBIRD_ENABLE_TLS=false

# TLS certificate path
SONGBIRD_TLS_CERT_PATH=/etc/ssl/certs/songbird.crt

# TLS private key path
SONGBIRD_TLS_KEY_PATH=/etc/ssl/private/songbird.key

# ===============================================
# 🧪 TESTING CONFIGURATION
# ===============================================

# Enable chaos engineering in tests
SONGBIRD_ENABLE_CHAOS_TESTING=false

# Test timeout in seconds
SONGBIRD_TEST_TIMEOUT_SECS=300

# Enable performance benchmarks
SONGBIRD_ENABLE_BENCHMARKS=false

# ===============================================
# 📝 NOTES
# ===============================================

# 1. Copy this file to .env for development
# 2. Never commit .env files with real secrets
# 3. Use environment-specific .env files (.env.production, .env.staging)
# 4. Generate secure secrets for production:
#    - JWT_SECRET: openssl rand -hex 64
#    - ENCRYPTION_KEY: openssl rand -hex 32
# 5. All hardcoded values have been eliminated in favor of these variables 