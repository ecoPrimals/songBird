# 🎵 Songbird Configuration - Environment Variables
# Copy this file to .env and customize for your environment

# ============================================================================
# ENVIRONMENT CONTROL
# ============================================================================

# Environment type: development, staging, production
SONGBIRD_ENVIRONMENT=development

# Log level: trace, debug, info, warn, error
SONGBIRD_LOG_LEVEL=info

# Enable debug mode
SONGBIRD_DEBUG=false

# ============================================================================
# CORE SERVICE CONFIGURATION
# ============================================================================

# Orchestrator Service
SONGBIRD_ORCHESTRATOR_HOST=127.0.0.1
SONGBIRD_ORCHESTRATOR_PORT=8080

# Discovery Service
SONGBIRD_DISCOVERY_HOST=127.0.0.1
SONGBIRD_DISCOVERY_PORT=8081

# Service Registry
SONGBIRD_REGISTRY_HOST=127.0.0.1
SONGBIRD_REGISTRY_PORT=8600

# ============================================================================
# PRIMAL SERVICES (Capability-Based Discovery)
# ============================================================================

# Security/BearDog
SONGBIRD_SECURITY_HOST=127.0.0.1
SONGBIRD_SECURITY_PORT=8443

# Storage/ToadStool
SONGBIRD_STORAGE_HOST=127.0.0.1
SONGBIRD_STORAGE_PORT=9000

# Compute
SONGBIRD_COMPUTE_HOST=127.0.0.1
SONGBIRD_COMPUTE_PORT=9100

# AI/Squirrel
SONGBIRD_AI_HOST=127.0.0.1
SONGBIRD_AI_PORT=9200

# Gaming
SONGBIRD_GAMING_HOST=127.0.0.1
SONGBIRD_GAMING_PORT=9300

# ============================================================================
# NETWORK CONFIGURATION
# ============================================================================

# Bind address for services
SONGBIRD_BIND_ADDRESS=0.0.0.0

# Default host for connections
SONGBIRD_DEFAULT_HOST=127.0.0.1

# Enable IPv6
SONGBIRD_ENABLE_IPV6=false

# Connection timeout (milliseconds)
SONGBIRD_CONNECTION_TIMEOUT_MS=5000

# Request timeout (milliseconds)
SONGBIRD_REQUEST_TIMEOUT_MS=30000

# ============================================================================
# FEDERATION CONFIGURATION
# ============================================================================

# Enable federation
SONGBIRD_ENABLE_FEDERATION=false

# Federation node ID
SONGBIRD_FEDERATION_NODE_ID=node-1

# Federation discovery endpoints (comma-separated)
SONGBIRD_FEDERATION_ENDPOINTS=

# Heartbeat interval (seconds)
SONGBIRD_FEDERATION_HEARTBEAT_INTERVAL=5

# ============================================================================
# OBSERVABILITY
# ============================================================================

# Metrics endpoint
SONGBIRD_METRICS_HOST=127.0.0.1
SONGBIRD_METRICS_PORT=9090

# Dashboard
SONGBIRD_DASHBOARD_HOST=127.0.0.1
SONGBIRD_DASHBOARD_PORT=3000

# Tracing
SONGBIRD_ENABLE_TRACING=true
SONGBIRD_TRACING_ENDPOINT=

# ============================================================================
# DEPLOYMENT SETTINGS
# ============================================================================

# Max concurrent connections
SONGBIRD_MAX_CONNECTIONS=1000

# Worker threads
SONGBIRD_WORKER_THREADS=4

# Enable TLS
SONGBIRD_ENABLE_TLS=false

# TLS certificate path
SONGBIRD_TLS_CERT_PATH=

# TLS key path
SONGBIRD_TLS_KEY_PATH=

# ============================================================================
# DEVELOPMENT HELPERS
# ============================================================================

# Enable mock services for testing
SONGBIRD_ENABLE_MOCKS=false

# Enable hot reload
SONGBIRD_HOT_RELOAD=false

# ============================================================================
# PRODUCTION OVERRIDES
# ============================================================================
# For production, override these values:
#
# SONGBIRD_ENVIRONMENT=production
# SONGBIRD_LOG_LEVEL=warn
# SONGBIRD_DEBUG=false
# SONGBIRD_ORCHESTRATOR_HOST=orchestrator.yourdomain.com
# SONGBIRD_DISCOVERY_HOST=discovery.yourdomain.com
# SONGBIRD_ENABLE_TLS=true
# SONGBIRD_TLS_CERT_PATH=/path/to/cert.pem
# SONGBIRD_TLS_KEY_PATH=/path/to/key.pem

# ============================================================================
# KUBERNETES/DOCKER EXAMPLES
# ============================================================================
# For containerized deployments:
#
# SONGBIRD_ORCHESTRATOR_HOST=songbird-orchestrator
# SONGBIRD_DISCOVERY_HOST=songbird-discovery
# SONGBIRD_REGISTRY_HOST=songbird-registry
# SONGBIRD_BIND_ADDRESS=0.0.0.0
#
# Services will use Kubernetes DNS or Docker network names
