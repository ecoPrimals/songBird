{
  "id": "toadstool",
  "name": "ToadStool Local GPU",
  "capabilities": [
    {
      "id": "ai:text-generation:local",
      "description": "Local GPU text generation via ToadStool",
      "category": "ai",
      "capability_type": "text-generation",
      "sub_type": "local",
      "metadata": {
        "provider_name": "ToadStool",
        "is_local": true,
        "cost_per_1k_tokens": 0.0,
        "avg_latency_ms": 500,
        "quality_tier": "high",
        "privacy": "100% local"
      }
    },
    {
      "id": "ai:embedding:local",
      "description": "Local embedding generation via ToadStool",
      "category": "ai",
      "capability_type": "embedding",
      "sub_type": "local",
      "metadata": {
        "provider_name": "ToadStool",
        "is_local": true,
        "dimensions": 768
      }
    }
  ],
  "socket_path": "/run/user/1000/toadstool-ai.sock",
  "backend": null,
  "metadata": {
    "rate_limit_requests_per_minute": 100,
    "cache_enabled": true,
    "cache_ttl_seconds": 120,
    "timeout_seconds": 30,
    "note": "Local primal - no external HTTP needed!"
  }
}

