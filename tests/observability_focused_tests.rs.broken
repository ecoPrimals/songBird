#[allow(dead_code, unused_imports, unused_variables)]
// Focused Observability Tests - Phase 4A
// 
// Expected: 25+ focused tests that compile and increase coverage

use chrono::Utc;

use std::sync::Arc;
use std::time::Duration;
use tokio::time::sleep;

use songbird_orchestrator::{
    config::ObservabilityConfig,
    observability::{MetricsCollector, MetricsSnapshot},
    Orchestrator, OrchestratorConfig,
};

/// Test utilities for observability testing
mod observability_test_utils {
    use super::*;

    /// Create test observability config
    pub fn create_test_observability_config() -> ObservabilityConfig {
        ObservabilityConfig {
            enabled: true,
            metrics_interval_secs: 1,
            health_check_interval_secs: 2,
            enable_dashboard: false,
            dashboard_port: 8081,
            export_prometheus: true,
            max_metric_history: 10,
            enable_system_metrics: true,
            enable_service_metrics: true,
        }
    }

    /// Create minimal observability config
    pub fn create_minimal_observability_config() -> ObservabilityConfig {
        ObservabilityConfig {
            enabled: false,
            metrics_interval_secs: 60,
            health_check_interval_secs: 120,
            enable_dashboard: false,
            dashboard_port: 9090,
            export_prometheus: false,
            max_metric_history: 100,
            enable_system_metrics: false,
            enable_service_metrics: false,
        }
    }

    /// Create test orchestrator
    pub async fn create_test_orchestrator() -> Arc<Orchestrator> {
        let config = OrchestratorConfig::default();
        Arc::new(Orchestrator::new(config).await.expect("Test assertion failed"))
    }
}

use observability_test_utils::*;

// ============================================================================
// METRICS COLLECTOR CORE FUNCTIONALITY TESTING
// ============================================================================

#[cfg(test)]
mod metrics_collector_tests {
    use super::*;

    #[tokio::test]
    async fn test_metrics_collector_creation() {
        let config = create_test_observability_config();
        let collector = MetricsCollector::new(config);
        
        assert!(collector.is_ok());
        let collector = collector.expect("Test assertion failed");
        
        // Test basic functionality
        assert_eq!(collector.get_collection_count(), 0);
        assert!(collector.last_collection_time().is_none());
    }

    #[tokio::test]
    async fn test_metrics_collector_with_minimal_config() {
        let config = create_minimal_observability_config();
        let collector = MetricsCollector::new(config);
        
        assert!(collector.is_ok());
        let collector = collector.expect("Test assertion failed");
        
        // Should work even with minimal config
        assert_eq!(collector.get_collection_count(), 0);
    }

    #[tokio::test]
    async fn test_system_metrics_collection() {
        let config = create_test_observability_config();
        let collector = MetricsCollector::new(config).expect("Test assertion failed");
        
        let metrics = collector.collect_system_metrics().await.expect("Test assertion failed");
        
        // Test system metrics structure
        assert!(metrics.cpu_usage >= 0.0);
        assert!(metrics.memory_usage >= 0.0 && metrics.memory_usage <= 1.0);
        assert!(metrics.memory_total_bytes > 0);
        assert!(metrics.memory_used_bytes <= metrics.memory_total_bytes);
        assert!(metrics.uptime.as_secs() > 0);
        assert!(metrics.process_count > 0);
        
        // Test load average structure
        assert!(metrics.load_average.one >= 0.0);
        assert!(metrics.load_average.five >= 0.0);
        assert!(metrics.load_average.fifteen >= 0.0);
        
        // Test disk metrics (currently defaults due to API changes)
        assert_eq!(metrics.disk_usage.total_bytes, 0);
        assert_eq!(metrics.disk_usage.used_bytes, 0);
        assert_eq!(metrics.disk_usage.available_bytes, 0);
        assert_eq!(metrics.disk_usage.usage_percentage, 0.0);
        
        // Test network metrics (currently defaults due to API changes)
        assert_eq!(metrics.network_stats.bytes_received, 0);
        assert_eq!(metrics.network_stats.bytes_transmitted, 0);
        assert_eq!(metrics.network_stats.packets_received, 0);
        assert_eq!(metrics.network_stats.packets_transmitted, 0);
        assert_eq!(metrics.network_stats.errors, 0);
    }

    #[tokio::test]
    async fn test_songbird_metrics_collection() {
        let config = create_test_observability_config();
        let collector = MetricsCollector::new(config).expect("Test assertion failed");
        
        let metrics = collector.collect_songbird_metrics().await.expect("Test assertion failed");
        
        // Test default songbird metrics
        assert_eq!(metrics.active_services, 0);
        assert_eq!(metrics.federation_nodes, 0);
        assert_eq!(metrics.request_rate, 0.0);
        assert_eq!(metrics.error_rate, 0.0);
        assert_eq!(metrics.avg_response_time_ms, 0.0);
        
        // Test circuit breaker metrics structure
        assert_eq!(metrics.circuit_breakers.open_circuits, 0);
        assert_eq!(metrics.circuit_breakers.half_open_circuits, 0);
        assert_eq!(metrics.circuit_breakers.total_trips, 0);
        assert_eq!(metrics.circuit_breakers.rejected_requests, 0);
        
        // Test load balancer metrics structure
        assert_eq!(metrics.load_balancer.total_requests, 0);
        assert_eq!(metrics.load_balancer.failed_requests, 0);
        assert_eq!(metrics.load_balancer.active_backends, 0);
        assert_eq!(metrics.load_balancer.avg_request_duration_ms, 0.0);
        
        // Test communication metrics structure
        assert_eq!(metrics.communication.messages_sent, 0);
        assert_eq!(metrics.communication.messages_received, 0);
        assert_eq!(metrics.communication.active_connections, 0);
        assert_eq!(metrics.communication.connection_errors, 0);
        assert_eq!(metrics.communication.bytes_sent, 0);
        assert_eq!(metrics.communication.bytes_received, 0);
    }

    #[tokio::test]
    async fn test_complete_metrics_collection() {
        let config = create_test_observability_config();
        let collector = MetricsCollector::new(config).expect("Test assertion failed");
        
        let snapshot = collector.collect_all_metrics().await.expect("Test assertion failed");
        
        // Test snapshot structure
        assert!(snapshot.collection_duration_ms > 0);
        assert!(snapshot.timestamp <= Utc::now());
        assert!(snapshot.services.is_empty()); // No services registered yet
        
        // Test system metrics are included
        assert!(snapshot.system.cpu_usage >= 0.0);
        assert!(snapshot.system.memory_usage >= 0.0);
        
        // Test songbird metrics are included
        assert_eq!(snapshot.songbird.active_services, 0);
        
        // Test collection tracking
        assert_eq!(collector.get_collection_count(), 1);
        assert!(collector.last_collection_time().is_some());
    }

    #[tokio::test]
    async fn test_metrics_collection_multiple_times() {
        let config = create_test_observability_config();
        let collector = MetricsCollector::new(config).expect("Test assertion failed");
        
        // Collect metrics multiple times
        for i in 1..=3 {
            let snapshot = collector.collect_all_metrics().await.expect("Test assertion failed");
            assert!(snapshot.collection_duration_ms > 0);
            assert_eq!(collector.get_collection_count(), i);
            sleep(Duration::from_millis(10)).await;
        }
        
        // Last collection time should be recent
        let last_time = collector.last_collection_time().expect("Test assertion failed");
        assert!(last_time <= Utc::now());
        assert!(last_time > Utc::now() - chrono::Duration::seconds(1));
    }

    #[tokio::test]
    async fn test_metrics_history_management() {
        let mut config = create_test_observability_config();
        config.max_metric_history = 2; // Small limit for testing
        let collector = MetricsCollector::new(config).expect("Test assertion failed");
        
        // Collect more snapshots than the limit
        for _ in 0..4 {
            collector.collect_all_metrics().await.expect("Test assertion failed");
            sleep(Duration::from_millis(10)).await;
        }
        
        let history = collector.get_history().await;
        
        // Should be limited to max_metric_history
        assert_eq!(history.len(), 2);
        
        // Should be in chronological order
        assert!(history[1].timestamp >= history[0].timestamp);
        
        // Collection count should still be accurate
        assert_eq!(collector.get_collection_count(), 4);
    }

    #[tokio::test]
    async fn test_app_metrics_update() {
        let config = create_test_observability_config();
        let collector = MetricsCollector::new(config).expect("Test assertion failed");
        
        // Update application metrics
        collector.update_app_metrics(|metrics| {
            metrics.active_services = 5;
            metrics.federation_nodes = 3;
            metrics.request_rate = 100.5;
            metrics.error_rate = 2.1;
            metrics.avg_response_time_ms = 45.7;
            
            // Update circuit breaker metrics
            metrics.circuit_breakers.open_circuits = 1;
            metrics.circuit_breakers.total_trips = 10;
            
            // Update load balancer metrics
            metrics.load_balancer.total_requests = 1000;
            metrics.load_balancer.active_backends = 3;
            
            // Update communication metrics
            metrics.communication.messages_sent = 500;
            metrics.communication.active_connections = 25;
        }).await.expect("Test assertion failed");
        
        let metrics = collector.collect_songbird_metrics().await.expect("Test assertion failed");
        
        // Verify updates
        assert_eq!(metrics.active_services, 5);
        assert_eq!(metrics.federation_nodes, 3);
        assert_eq!(metrics.request_rate, 100.5);
        assert_eq!(metrics.error_rate, 2.1);
        assert_eq!(metrics.avg_response_time_ms, 45.7);
        
        // Verify nested metrics
        assert_eq!(metrics.circuit_breakers.open_circuits, 1);
        assert_eq!(metrics.circuit_breakers.total_trips, 10);
        assert_eq!(metrics.load_balancer.total_requests, 1000);
        assert_eq!(metrics.load_balancer.active_backends, 3);
        assert_eq!(metrics.communication.messages_sent, 500);
        assert_eq!(metrics.communication.active_connections, 25);
    }

    #[tokio::test]
        let config = create_test_observability_config();
        let collector = MetricsCollector::new(config).expect("Test assertion failed");
        
        collector.increment_request_count();
        collector.increment_error_count();
        collector.update_service_count(5);
        collector.add_response_time(150);
        
        // These methods should work without panicking
        // The actual counting/tracking happens internally
    }

    #[tokio::test]
    async fn test_prometheus_export() {
        let config = create_test_observability_config();
        let collector = MetricsCollector::new(config).expect("Test assertion failed");
        
        // Update some metrics first
        collector.update_app_metrics(|metrics| {
            metrics.active_services = 5;
            metrics.request_rate = 100.0;
            metrics.error_rate = 2.0;
        }).await.expect("Test assertion failed");
        
        let prometheus_output = collector.export_prometheus().await.expect("Test assertion failed");
        
        // Verify Prometheus format
        assert!(prometheus_output.contains("# HELP"));
        assert!(prometheus_output.contains("# TYPE"));
        assert!(prometheus_output.contains("songbird_"));
        
        // Should contain key metrics
        assert!(prometheus_output.contains("songbird_cpu_usage_percent"));
        assert!(prometheus_output.contains("songbird_memory_usage_ratio"));
        assert!(prometheus_output.contains("songbird_active_services"));
        assert!(prometheus_output.contains("songbird_request_rate"));
        assert!(prometheus_output.contains("songbird_error_rate"));
    }

    #[tokio::test]
    async fn test_metrics_snapshot_consistency() {
        let config = create_test_observability_config();
        let collector = MetricsCollector::new(config).expect("Test assertion failed");
        
        // Update metrics
        collector.update_app_metrics(|metrics| {
            metrics.active_services = 10;
            metrics.request_rate = 50.0;
        }).await.expect("Test assertion failed");
        
        let snapshot1 = collector.get_current_snapshot().await.expect("Test assertion failed");
        let snapshot2 = collector.get_current_metrics().await.expect("Test assertion failed");
        
        // Both methods should return consistent data
        assert_eq!(snapshot1.songbird.active_services, snapshot2.songbird.active_services);
        assert_eq!(snapshot1.songbird.request_rate, snapshot2.songbird.request_rate);
        
        // Timestamps should be very close (allow up to 1 second difference for CI environments)
        let time_diff = snapshot2.timestamp.signed_duration_since(snapshot1.timestamp);
        assert!(time_diff.num_milliseconds().abs() < 1000, "Time difference too large: {}ms", time_diff.num_milliseconds());
    }

    #[tokio::test]
    async fn test_concurrent_metrics_collection() {
        let config = create_test_observability_config();
        let collector = Arc::new(MetricsCollector::new(config).expect("Test assertion failed"));
        
        // Spawn multiple concurrent collection tasks
        let mut handles = vec![];
        for i in 0..5 {
            let collector_clone = collector.clone();
            let handle = tokio::spawn(async move {
                // Update metrics concurrently
                collector_clone.update_app_metrics(|metrics| {
                    metrics.active_services = i;
                    metrics.request_rate = i as f64 * 10.0;
                }).await.expect("Test assertion failed");
                
                // Collect metrics
                collector_clone.collect_all_metrics().await.expect("Test assertion failed")
            });
            handles.push(handle);
        }
        
        // Wait for all tasks to complete
        let mut snapshots = vec![];
        for handle in handles {
            let snapshot = handle.await.expect("Test assertion failed");
            snapshots.push(snapshot);
        }
        
        // Should have 5 snapshots
        assert_eq!(snapshots.len(), 5);
        
        // Collection count should be 5
        assert_eq!(collector.get_collection_count(), 5);
        
        // All snapshots should be valid
        for snapshot in snapshots {
            assert!(snapshot.collection_duration_ms > 0);
            assert!(snapshot.timestamp <= Utc::now());
        }
    }

    #[tokio::test]
    async fn test_metrics_error_handling() {
        let config = create_test_observability_config();
        let collector = MetricsCollector::new(config).expect("Test assertion failed");
        
        // Test that metrics collection handles errors gracefully
        let result = collector.collect_system_metrics().await;
        assert!(result.is_ok());
        
        let result = collector.collect_songbird_metrics().await;
        assert!(result.is_ok());
        
        let result = collector.collect_all_metrics().await;
        assert!(result.is_ok());
    }

    #[tokio::test]
    async fn test_memory_usage_calculation() {
        let config = create_test_observability_config();
        let collector = MetricsCollector::new(config).expect("Test assertion failed");
        
        let metrics = collector.collect_system_metrics().await.expect("Test assertion failed");
        
        // Memory usage should be consistent
        assert!(metrics.memory_used_bytes <= metrics.memory_total_bytes);
        
        if metrics.memory_total_bytes > 0 {
            let calculated_ratio = metrics.memory_used_bytes as f64 / metrics.memory_total_bytes as f64;
            assert!((metrics.memory_usage - calculated_ratio).abs() < 0.001);
        }
    }

    #[tokio::test]
    async fn test_metrics_timestamp_accuracy() {
        let config = create_test_observability_config();
        let collector = MetricsCollector::new(config).expect("Test assertion failed");
        
        let before = Utc::now();
        let snapshot = collector.collect_all_metrics().await.expect("Test assertion failed");
        let after = Utc::now();
        
        // Timestamp should be within the collection window
        assert!(snapshot.timestamp >= before);
        assert!(snapshot.timestamp <= after);
        
        // Collection duration should be reasonable
        assert!(snapshot.collection_duration_ms < 1000); // Less than 1 second
    }
}

// ============================================================================
// OBSERVABILITY CONFIG TESTING
// ============================================================================

#[cfg(test)]
mod observability_config_tests {
    use super::*;

    #[test]
    fn test_observability_config_default() {
        let config = ObservabilityConfig::default();
        
        assert!(config.enabled);
        assert_eq!(config.metrics_interval_secs, 30);
        assert_eq!(config.health_check_interval_secs, 60);
        assert!(!config.enable_dashboard);
        assert_eq!(config.dashboard_port, 8081);
        assert!(!config.export_prometheus);
        assert_eq!(config.max_metric_history, 1000);
        assert!(config.enable_system_metrics);
        assert!(config.enable_service_metrics);
    }

    #[test]
    fn test_observability_config_custom() {
        let config = ObservabilityConfig {
            enabled: false,
            metrics_interval_secs: 60,
            health_check_interval_secs: 120,
            enable_dashboard: true,
            dashboard_port: 9090,
            export_prometheus: true,
            max_metric_history: 500,
            enable_system_metrics: false,
            enable_service_metrics: false,
        };
        
        assert!(!config.enabled);
        assert_eq!(config.metrics_interval_secs, 60);
        assert_eq!(config.health_check_interval_secs, 120);
        assert!(config.enable_dashboard);
        assert_eq!(config.dashboard_port, 9090);
        assert!(config.export_prometheus);
        assert_eq!(config.max_metric_history, 500);
        assert!(!config.enable_system_metrics);
        assert!(!config.enable_service_metrics);
    }

    #[test]
    fn test_observability_config_serialization() {
        let config = create_test_observability_config();
        
        // Test serialization
        let serialized = serde_json::to_string(&config).expect("Test assertion failed");
        assert!(serialized.contains("enabled"));
        assert!(serialized.contains("metrics_interval_secs"));
        assert!(serialized.contains("export_prometheus"));
        
        // Test deserialization
        let deserialized: ObservabilityConfig = serde_json::from_str(&serialized).expect("Test assertion failed");
        assert_eq!(config.enabled, deserialized.enabled);
        assert_eq!(config.metrics_interval_secs, deserialized.metrics_interval_secs);
        assert_eq!(config.export_prometheus, deserialized.export_prometheus);
    }

    #[test]
    fn test_observability_config_validation() {
        // Test valid configs
        let valid_configs = vec![
            create_test_observability_config(),
            create_minimal_observability_config(),
            ObservabilityConfig::default(),
        ];
        
        for config in valid_configs {
            // All configs should be usable to create a MetricsCollector
            let collector = MetricsCollector::new(config);
            assert!(collector.is_ok());
        }
    }
}
