# Songbird Environment Configuration Example
#
# Copy this file to .env and customize for your environment
# All values shown are the defaults used when environment variables are not set

# ============================================================================
# ENVIRONMENT
# ============================================================================

# Environment mode: development, staging, or production
SONGBIRD_ENVIRONMENT=development

# ============================================================================
# NETWORKING - HOSTS
# ============================================================================

# Default service host (used when specific host not set)
SONGBIRD_HOST=127.0.0.1

# Bind address for services (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
SONGBIRD_BIND_ADDRESS=0.0.0.0

# Specific service hosts (optional, defaults to SONGBIRD_HOST)
SONGBIRD_ORCHESTRATOR_HOST=127.0.0.1
SONGBIRD_DISCOVERY_HOST=127.0.0.1

# ============================================================================
# NETWORKING - PORTS
# ============================================================================

# Core service ports
SONGBIRD_ORCHESTRATOR_PORT=8080
SONGBIRD_DISCOVERY_PORT=8081
SONGBIRD_DASHBOARD_PORT=3000
SONGBIRD_METRICS_PORT=9090
SONGBIRD_FEDERATION_PORT=8082
SONGBIRD_WEBSOCKET_PORT=8080

# ============================================================================
# ENDPOINTS
# ============================================================================

# Full service URLs (optional, will be constructed from host + port if not set)
# SONGBIRD_ORCHESTRATOR_URL=http://127.0.0.1:8080
# SONGBIRD_DISCOVERY_URL=http://127.0.0.1:8081
# SONGBIRD_DASHBOARD_URL=http://127.0.0.1:3000
# SONGBIRD_METRICS_URL=http://127.0.0.1:9090
# SONGBIRD_WEBSOCKET_URL=ws://127.0.0.1:8080

# CORS allowed origins (comma-separated)
SONGBIRD_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================================================
# TIMEOUTS (in milliseconds)
# ============================================================================

# Standard timeout for most operations
SONGBIRD_TIMEOUT_MS=5000

# Long timeout for slow operations
SONGBIRD_LONG_TIMEOUT_MS=30000

# HTTP request timeout
SONGBIRD_REQUEST_TIMEOUT_MS=30000

# Cache expiration time
SONGBIRD_CACHE_EXPIRY_MS=300000

# Service heartbeat interval
SONGBIRD_HEARTBEAT_INTERVAL_MS=60000

# Service discovery timeout
SONGBIRD_DISCOVERY_TIMEOUT_MS=5000

# Connection timeout
SONGBIRD_CONNECTION_TIMEOUT_MS=10000

# Retry backoff delay
SONGBIRD_RETRY_BACKOFF_MS=1000

# ============================================================================
# PRIMAL SERVICES (Ecosystem Integration)
# ============================================================================

# Note: With universal capability-based discovery, you typically don't need
# to hardcode primal service URLs. However, you can override discovery with:
#
# SONGBIRD_TOADSTOOL_URL=http://toadstool:8001
# SONGBIRD_BEARDOG_URL=http://beardog:8004
# SONGBIRD_NESTGATE_URL=http://nestgate:8003
# SONGBIRD_SQUIRREL_URL=http://squirrel:8002

# ============================================================================
# DEPLOYMENT-SPECIFIC EXAMPLES
# ============================================================================

# --- DEVELOPMENT (Local) ---
# SONGBIRD_ENVIRONMENT=development
# SONGBIRD_HOST=127.0.0.1
# SONGBIRD_BIND_ADDRESS=127.0.0.1
# SONGBIRD_ORCHESTRATOR_PORT=8080
# SONGBIRD_TIMEOUT_MS=5000

# --- STAGING ---
# SONGBIRD_ENVIRONMENT=staging
# SONGBIRD_HOST=staging.internal
# SONGBIRD_BIND_ADDRESS=0.0.0.0
# SONGBIRD_ORCHESTRATOR_PORT=80
# SONGBIRD_TIMEOUT_MS=10000

# --- PRODUCTION ---
# SONGBIRD_ENVIRONMENT=production
# SONGBIRD_HOST=songbird.example.com
# SONGBIRD_BIND_ADDRESS=0.0.0.0
# SONGBIRD_ORCHESTRATOR_PORT=80
# SONGBIRD_TIMEOUT_MS=30000
# SONGBIRD_CORS_ORIGINS=https://app.example.com,https://dashboard.example.com

# --- DOCKER COMPOSE ---
# SONGBIRD_ENVIRONMENT=development
# SONGBIRD_HOST=songbird-orchestrator
# SONGBIRD_ORCHESTRATOR_PORT=8080
# SONGBIRD_DISCOVERY_PORT=8081

# --- KUBERNETES ---
# SONGBIRD_ENVIRONMENT=production
# SONGBIRD_HOST=songbird-orchestrator.default.svc.cluster.local
# SONGBIRD_ORCHESTRATOR_PORT=8080
# SONGBIRD_DISCOVERY_PORT=8081

# ============================================================================
# ADVANCED CONFIGURATION
# ============================================================================

# Custom service ports (for any additional services)
# SONGBIRD_CUSTOM_SERVICE_PORT=9000

# Custom service hosts
# SONGBIRD_CUSTOM_SERVICE_HOST=custom.local

# Custom operation timeouts
# SONGBIRD_BACKUP_TIMEOUT_MS=120000
# SONGBIRD_MIGRATION_TIMEOUT_MS=60000

# ============================================================================
# TESTING
# ============================================================================

# For testing, you can override with test-specific values:
# SONGBIRD_ORCHESTRATOR_PORT=18080
# SONGBIRD_DISCOVERY_PORT=18081
# SONGBIRD_TIMEOUT_MS=1000

# ============================================================================
# NOTES
# ============================================================================

# 1. All environment variables are optional - defaults are used when not set
# 2. Port numbers should be > 1024 for non-root users
# 3. Use 0.0.0.0 as BIND_ADDRESS in production to accept external connections
# 4. Use 127.0.0.1 as BIND_ADDRESS in development for security
# 5. CORS_ORIGINS should list all allowed frontend origins
# 6. Timeouts in milliseconds (1000 = 1 second)
# 7. See documentation for full list of configuration options

