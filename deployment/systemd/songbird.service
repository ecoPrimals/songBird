# Songbird systemd Service Unit
# genomeBin-compliant deployment wrapper for Linux systems
#
# Installation:
#   sudo cp songbird.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable songbird
#   sudo systemctl start songbird
#
# Status:
#   systemctl status songbird
#   journalctl -u songbird -f

[Unit]
Description=Songbird Network Orchestrator (ecoPrimals)
Documentation=https://github.com/ecoPrimals/songbird
After=network-online.target
Wants=network-online.target
# Optional: Wait for Security Provider if available
After=security-provider.service
Wants=security-provider.service

[Service]
Type=notify
NotifyAccess=main

# Binary location (adjust for your installation)
ExecStart=/usr/local/bin/songbird

# Runtime directory for sockets (XDG-compliant)
RuntimeDirectory=songbird
RuntimeDirectoryMode=0755

# State directory for persistent data
StateDirectory=songbird
StateDirectoryMode=0700

# Cache directory for temporary data
CacheDirectory=songbird
CacheDirectoryMode=0700

# Configuration directory
ConfigurationDirectory=songbird
ConfigurationDirectoryMode=0755

# Environment variables (capability-based, zero hardcoding!)
Environment="SONGBIRD_FAMILY_ID=default"
Environment="RUST_LOG=info"
Environment="SONGBIRD_MODE=daemon"

# Security Hardening (TRUE ecoBin security standards)
# Process isolation
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/songbird /var/cache/songbird

# Namespace isolation
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

# System call filtering
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

# Restrict address families (networking required)
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# Capabilities (minimal required for networking)
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Resource limits
LimitNOFILE=65536
LimitNPROC=512

# Restart policy (resilient operation)
Restart=on-failure
RestartSec=5s
StartLimitInterval=60s
StartLimitBurst=3

# Watchdog (if supported by binary)
WatchdogSec=30s

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=songbird

# User/Group (run as dedicated user - recommended!)
# User=songbird
# Group=songbird
# Uncomment above and create user:
#   sudo useradd -r -s /bin/false -d /var/lib/songbird songbird

[Install]
WantedBy=multi-user.target
