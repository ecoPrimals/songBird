# =============================================================================
# SONGBIRD UNIVERSAL ORCHESTRATOR - PRODUCTION ENVIRONMENT
# =============================================================================
# 
# This file contains production environment variables for Songbird deployment.
# Copy to /etc/songbird/environment and customize for your environment.
#
# Version: 1.0
# Target: Production deployment
# Status: Production Ready
#
# =============================================================================

# === SONGBIRD CORE CONFIGURATION ===
SONGBIRD_CONFIG_PATH=/etc/songbird/songbird.toml
SONGBIRD_LOG_LEVEL=info
SONGBIRD_BIND_ADDRESS=0.0.0.0:8080
SONGBIRD_EXTERNAL_ADDRESS=https://songbird.yourdomain.com

# === RESOURCE LIMITS ===
SONGBIRD_MEMORY_LIMIT_MB=2048
SONGBIRD_MAX_CONNECTIONS=1000
SONGBIRD_WORKER_THREADS=4

# === SERVICE DISCOVERY ===
SONGBIRD_DISCOVERY_TIMEOUT=30
SONGBIRD_HEALTH_CHECK_INTERVAL=15
SONGBIRD_SERVICE_RETRY_COUNT=3

# === FEDERATION SETTINGS ===
SONGBIRD_FEDERATION_ENABLED=true
SONGBIRD_CLUSTER_NAME=songbird-production
SONGBIRD_NODE_ID=songbird-node-01

# === SSL/TLS CONFIGURATION ===
SONGBIRD_ENABLE_TLS=true
SONGBIRD_CERT_PATH=/etc/ssl/certs/songbird.crt
SONGBIRD_KEY_PATH=/etc/ssl/private/songbird.key

# === PRIMAL SERVICE ENDPOINTS ===
# Configure these to match your ecosystem deployment
BEARDOG_ENDPOINT=https://beardog.internal:8443
NESTGATE_ENDPOINT=https://nestgate.internal:8080
TOADSTOOL_ENDPOINT=https://toadstool.internal:8082
SQUIRREL_ENDPOINT=https://squirrel.internal:8083

# === RESOURCE MONITORING (Delegated to ToadStool) ===
# These values are used as fallbacks when ToadStool is unavailable
SONGBIRD_CPU_UTILIZATION=25.0
SONGBIRD_TOTAL_MEMORY_GB=16
SONGBIRD_AVAILABLE_MEMORY_GB=8
SONGBIRD_SYSTEM_LOAD=0.5,0.7,0.8

# === SECURITY SETTINGS ===
SONGBIRD_ENABLE_AUDIT_LOGGING=true
SONGBIRD_SECURITY_LEVEL=production
SONGBIRD_RATE_LIMIT_ENABLED=true

# === MONITORING & OBSERVABILITY ===
SONGBIRD_ENABLE_METRICS=true
SONGBIRD_METRICS_PORT=9090
SONGBIRD_HEALTH_CHECK_PORT=8081
SONGBIRD_ENABLE_TRACING=true

# === PERFORMANCE TUNING ===
SONGBIRD_CONNECTION_POOL_SIZE=100
SONGBIRD_REQUEST_BUFFER_SIZE=8192
SONGBIRD_TCP_NODELAY=true
SONGBIRD_TCP_KEEPALIVE=true
SONGBIRD_KEEPALIVE_TIMEOUT=60

# === LOGGING CONFIGURATION ===
SONGBIRD_LOG_FORMAT=json
SONGBIRD_LOG_OUTPUT=stdout
SONGBIRD_ENABLE_STRUCTURED_LOGGING=true

# === ADDITIONAL PRODUCTION SETTINGS ===
# Uncomment and configure as needed for your environment

# Custom cluster endpoints (for multi-node federation)
# SONGBIRD_CLUSTER_ENDPOINTS=https://node1.internal:8080,https://node2.internal:8080,https://node3.internal:8080

# Custom CA certificate path (if using internal CA)
# SONGBIRD_CA_CERT_PATH=/etc/ssl/certs/ca-certificates.crt

# Custom DNS servers (if needed)
# SONGBIRD_DNS_SERVERS=10.0.0.1,10.0.0.2

# Proxy settings (if behind corporate proxy)
# HTTPS_PROXY=https://proxy.company.com:8080
# HTTP_PROXY=http://proxy.company.com:8080
# NO_PROXY=localhost,127.0.0.1,.internal,.local

