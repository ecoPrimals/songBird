#[macro_use]
extern crate songbird_security;

//! BearDog Integration Tests for Songbird Security
//!
//! This module contains comprehensive tests for BearDog security integration
//! including security workflows, performance benchmarks, and error handling.

use std::time::SystemTime;
use chrono::Utc;

mod test_framework;
use test_framework::*;
use songbird_security::FriendTrustLevel;

/// Test BearDog security integration
#[tokio::test]
async fn test_beardog_security_integration() {
    let mut framework = init_beardog_test!("BearDog Security Integration");

    // Test BearDog initialization
    println!("🐕 Testing BearDog security integration initialization");
    
    // Test threat detection integration
    let threat_scenario = TestThreatScenario {
        scenario_id: "beardog_threat_001".to_string(),
        threat_type: ThreatType::Malware,
        severity: ThreatSeverity::High,
        source: ThreatSource::External,
        target: "test_system".to_string(),
        description: "BearDog threat detection test".to_string(),
        indicators: vec![
            ThreatIndicator {
                indicator_type: "file_signature".to_string(),
                value: "malware_signature_xyz".to_string(),
                confidence: 0.9,
                timestamp: SystemTime::now(),
            },
        ],
        expected_response: ThreatResponse::Block,
        confidence: 0.8,
    };

    let threat_detected = framework.run_threat_detection_test(threat_scenario).await;
    assert!(threat_detected, "BearDog should detect threats");

    // Test zero trust integration
    let zero_trust_test = ZeroTrustTestCase {
        test_id: "beardog_zt_001".to_string(),
        device_id: "test_device".to_string(),
        user_id: "test_user".to_string(),
        resource: "test_resource".to_string(),
        action: "read".to_string(),
        context: ZeroTrustContext {
            device_trust_level: 0.8,
            network_location: NetworkLocation::HomeNetwork,
            time_of_access: SystemTime::now(),
            behavioral_anomaly_score: 0.2,
            session_state: SessionState::Established,
        },
        expected_access: true,
        verification_steps: vec![],
    };

    let zero_trust_result = framework.test_zero_trust_access(zero_trust_test).await;
    assert!(zero_trust_result, "BearDog zero trust should work");

    // Test encryption integration
    let encryption_strong = framework.test_encryption_strength().await;
    assert!(encryption_strong, "BearDog encryption should be strong");

    println!("✅ BearDog security integration tests passed");
}

/// Test BearDog zero trust integration
#[tokio::test]
async fn test_beardog_zero_trust_integration() {
    let mut framework = init_beardog_test!("BearDog Zero Trust Integration");

    // Test device trust evaluation
    let device_trust_tests = vec![
        ("family_laptop", 0.9, true),
        ("guest_device", 0.3, false),
        ("work_device", 0.8, true),
        ("unknown_device", 0.1, false),
    ];

    for (device_id, trust_level, expected_access) in device_trust_tests {
        let test_case = ZeroTrustTestCase {
            test_id: format!("beardog_device_{}", device_id),
            device_id: device_id.to_string(),
            user_id: "test_user".to_string(),
            resource: "protected_resource".to_string(),
            action: "access".to_string(),
            context: ZeroTrustContext {
                device_trust_level: trust_level,
                network_location: NetworkLocation::HomeNetwork,
                time_of_access: SystemTime::now(),
                behavioral_anomaly_score: 0.1,
                session_state: SessionState::Established,
            },
            expected_access,
            verification_steps: vec![],
        };

        let result = framework.test_zero_trust_access(test_case).await;
        assert!(result, "BearDog device trust test should pass for: {}", device_id);
    }

    // Test network location sensitivity
    let network_tests = vec![
        (NetworkLocation::HomeNetwork, true),
        (NetworkLocation::Internal, true),
        (NetworkLocation::RemoteVPN, true),
        (NetworkLocation::PublicWiFi, false),
        (NetworkLocation::External, false),
        (NetworkLocation::Unknown, false),
    ];

    for (location, expected_access) in network_tests {
        let test_case = ZeroTrustTestCase {
            test_id: format!("beardog_network_{:?}", location),
            device_id: "trusted_device".to_string(),
            user_id: "trusted_user".to_string(),
            resource: "sensitive_data".to_string(),
            action: "read".to_string(),
            context: ZeroTrustContext {
                device_trust_level: 0.9,
                network_location: location,
                time_of_access: SystemTime::now(),
                behavioral_anomaly_score: 0.1,
                session_state: SessionState::Established,
            },
            expected_access,
            verification_steps: vec![],
        };

        let result = framework.test_zero_trust_access(test_case).await;
        assert!(result, "BearDog network location test should pass for: {:?}", location);
    }

    println!("✅ BearDog zero trust integration tests passed");
}

/// Test BearDog performance benchmarks
#[tokio::test]
async fn test_beardog_performance_benchmarks() {
    let mut framework = init_beardog_test!("BearDog Performance Benchmarks");

    println!("🏃 Testing BearDog performance benchmarks");

    // Test threat detection performance
    let start_time = SystemTime::now();
    
    for i in 0..10 {
        let threat_scenario = TestThreatScenario {
            scenario_id: format!("perf_test_{}", i),
            threat_type: ThreatType::Malware,
            severity: ThreatSeverity::Medium,
            source: ThreatSource::External,
            target: "performance_test".to_string(),
            description: format!("Performance test scenario {}", i),
            indicators: vec![
                ThreatIndicator {
                    indicator_type: "performance_test".to_string(),
                    value: format!("test_value_{}", i),
                    confidence: 0.8,
                    timestamp: SystemTime::now(),
                },
            ],
            expected_response: ThreatResponse::Monitor,
        confidence: 0.8,
        };

        let _detected = framework.run_threat_detection_test(threat_scenario).await;
    }

    let elapsed = start_time.elapsed().expect("Time should be measurable");
    println!("   Threat detection: 10 tests in {:?}", elapsed);
    
    // Should complete threat detection in reasonable time
    assert!(elapsed.as_millis() < 5000, "Threat detection should be fast");

    // Test zero trust performance
    let start_time = SystemTime::now();
    
    for i in 0..10 {
        let test_case = ZeroTrustTestCase {
            test_id: format!("perf_zt_{}", i),
            device_id: "perf_device".to_string(),
            user_id: "perf_user".to_string(),
            resource: "perf_resource".to_string(),
            action: "read".to_string(),
            context: ZeroTrustContext {
                device_trust_level: 0.8,
                network_location: NetworkLocation::HomeNetwork,
                time_of_access: SystemTime::now(),
                behavioral_anomaly_score: 0.2,
                session_state: SessionState::Established,
            },
            expected_access: true,
            verification_steps: vec![],
        };

        let _result = framework.test_zero_trust_access(test_case).await;
    }

    let elapsed = start_time.elapsed().expect("Time should be measurable");
    println!("   Zero trust: 10 tests in {:?}", elapsed);
    
    // Should complete zero trust checks in reasonable time
    assert!(elapsed.as_millis() < 2000, "Zero trust should be fast");

    // Test encryption performance
    let start_time = SystemTime::now();
    
    for _i in 0..5 {
        let _encryption_result = framework.test_encryption_strength().await;
    }

    let elapsed = start_time.elapsed().expect("Time should be measurable");
    println!("   Encryption: 5 tests in {:?}", elapsed);
    
    // Should complete encryption tests in reasonable time
    assert!(elapsed.as_millis() < 1000, "Encryption should be fast");

    println!("✅ BearDog performance benchmarks passed");
}

/// Test BearDog concurrent operations
#[tokio::test]
async fn test_beardog_concurrent_operations() {
    let mut framework = init_beardog_test!("BearDog Concurrent Operations");

    println!("🔄 Testing BearDog concurrent operations");

    // Test concurrent threat detection
    let mut threat_handles = Vec::new();
    
    for i in 0..5 {
        let threat_scenario = TestThreatScenario {
            scenario_id: format!("concurrent_threat_{}", i),
            threat_type: ThreatType::NetworkIntrusion,
            severity: ThreatSeverity::Medium,
            source: ThreatSource::External,
            target: "concurrent_test".to_string(),
            description: format!("Concurrent threat test {}", i),
            indicators: vec![
                ThreatIndicator {
                    indicator_type: "concurrent_test".to_string(),
                    value: format!("concurrent_value_{}", i),
                    confidence: 0.7,
                    timestamp: SystemTime::now(),
                },
            ],
            expected_response: ThreatResponse::Monitor,
        confidence: 0.8,
        };

        // Note: In a real concurrent test, we'd spawn async tasks
        // For now, we'll test sequentially but simulate concurrent behavior
        let detected = framework.run_threat_detection_test(threat_scenario).await;
        threat_handles.push(detected);
    }

    // All concurrent threat detections should succeed
    for (i, result) in threat_handles.iter().enumerate() {
        assert!(*result, "Concurrent threat test {} should succeed", i);
    }

    // Test concurrent zero trust checks
    let mut zt_handles = Vec::new();
    
    for i in 0..5 {
        let test_case = ZeroTrustTestCase {
            test_id: format!("concurrent_zt_{}", i),
            device_id: format!("concurrent_device_{}", i),
            user_id: "concurrent_user".to_string(),
            resource: "concurrent_resource".to_string(),
            action: "read".to_string(),
            context: ZeroTrustContext {
                device_trust_level: 0.8,
                network_location: NetworkLocation::HomeNetwork,
                time_of_access: SystemTime::now(),
                behavioral_anomaly_score: 0.2,
                session_state: SessionState::Established,
            },
            expected_access: true,
            verification_steps: vec![],
        };

        let result = framework.test_zero_trust_access(test_case).await;
        zt_handles.push(result);
    }

    // All concurrent zero trust checks should succeed
    for (i, result) in zt_handles.iter().enumerate() {
        assert!(*result, "Concurrent zero trust test {} should succeed", i);
    }

    println!("✅ BearDog concurrent operations tests passed");
}

/// Test BearDog error handling
#[tokio::test]
async fn test_beardog_error_handling() {
    let mut framework = init_beardog_test!("BearDog Error Handling");

    println!("⚠️ Testing BearDog error handling");

    // Test malformed threat scenarios
    let malformed_threat = TestThreatScenario {
        scenario_id: "malformed_test".to_string(),
        threat_type: ThreatType::Unknown,
        severity: ThreatSeverity::Informational,
        source: ThreatSource::Unknown,
        target: "".to_string(), // Empty target
        description: "Malformed threat test".to_string(),
        indicators: vec![], // Empty indicators
        expected_response: ThreatResponse::Allow,
        confidence: 0.8,
    };

    // Should handle malformed input gracefully
    let result = framework.run_threat_detection_test(malformed_threat).await;
    // Result should be false (not detected) due to low severity and empty indicators
    assert!(!result, "Malformed threat should not be detected");

    // Test invalid zero trust context
    let invalid_zt_test = ZeroTrustTestCase {
        test_id: "invalid_zt_test".to_string(),
        device_id: "".to_string(), // Empty device ID
        user_id: "".to_string(), // Empty user ID
        resource: "".to_string(), // Empty resource
        action: "".to_string(), // Empty action
        context: ZeroTrustContext {
            device_trust_level: -1.0, // Invalid trust level
            network_location: NetworkLocation::Unknown,
            time_of_access: SystemTime::now(),
            behavioral_anomaly_score: 2.0, // Invalid anomaly score
            session_state: SessionState::Compromised,
        },
        expected_access: false,
        verification_steps: vec![],
    };

    // Should handle invalid input gracefully
    let result = framework.test_zero_trust_access(invalid_zt_test).await;
    assert!(result, "Invalid zero trust test should be handled gracefully");

    println!("✅ BearDog error handling tests passed");
}

/// Test family protection scenarios
#[tokio::test]
async fn test_family_protection_scenarios() {
    let mut framework = init_beardog_test!("Family Protection Scenarios");

    println!("👨‍👩‍👧‍👦 Testing family protection scenarios");

    // Test various family protection scenarios
    let family_scenarios = vec![
        ("grandparent", "tech_support_call", true),
        ("parent", "suspicious_download", true),
        ("child", "unknown_remote_access", true),
        ("teenager", "normal_browsing", false),
        ("family_member", "online_banking", false),
        ("guest", "file_sharing", false),
    ];

    for (family_member, activity, should_be_protected) in family_scenarios {
        let protected = framework.test_family_protection(family_member, activity).await;
        
        if should_be_protected {
            assert!(protected, "Family member {} should be protected from {}", family_member, activity);
        } else {
            assert!(!protected, "Family member {} should not be restricted from {}", family_member, activity);
        }
    }

    println!("✅ Family protection scenario tests passed");
}

/// Test gaming security scenarios
#[tokio::test]
async fn test_gaming_security_scenarios() {
    let mut framework = init_beardog_test!("Gaming Security Scenarios");

    println!("🎮 Testing gaming security scenarios");

    // Test gaming security with various player trust levels
    let gaming_test = GamingSecurityTest {
        test_id: "gaming_security_001".to_string(),
        game_session_id: "test_session_123".to_string(),
        players: vec![
            GamingPlayer {
                player_id: "player_1".to_string(),
                trust_level: FriendTrustLevel::Family { verified_at: chrono::Utc::now() },
                device_id: "family_device".to_string(),
                connection_quality: ConnectionQuality::Excellent,
                behavioral_score: 0.9,
            },
            GamingPlayer {
                player_id: "player_2".to_string(),
                trust_level: FriendTrustLevel::Friend { verified_at: chrono::Utc::now() },
                device_id: "friend_device".to_string(),
                connection_quality: ConnectionQuality::Good,
                behavioral_score: 0.8,
            },
            GamingPlayer {
                player_id: "player_3".to_string(),
                trust_level: FriendTrustLevel::Unknown,
                device_id: "unknown_device".to_string(),
                connection_quality: ConnectionQuality::Fair,
                behavioral_score: 0.5,
            },
        ],
        security_requirements: GamingSecurityRequirements {
            anti_cheat: true,
            ddos_protection: true,
            voice_chat_moderation: true,
            player_verification: true,
            data_encryption: true,
        },
        threat_scenarios: vec![
            GamingThreatScenario::Cheating,
            GamingThreatScenario::Toxicity,
            GamingThreatScenario::DDoSAttack,
        ],
    };

    let gaming_secure = framework.test_gaming_security(gaming_test).await;
    assert!(gaming_secure, "Gaming security should be maintained");

    println!("✅ Gaming security scenario tests passed");
}

/// Test compliance reporting
#[tokio::test]
async fn test_compliance_reporting() {
    let mut framework = init_beardog_test!("Compliance Reporting");

    println!("📊 Testing compliance reporting");

    let compliance_report = framework.generate_compliance_report().await;
    
    // Verify compliance report structure
    assert!(compliance_report.overall_score >= 0.0, "Compliance score should be non-negative");
    assert!(compliance_report.overall_score <= 10.0, "Compliance score should be within range");
    assert!(!compliance_report.recommendations.is_empty(), "Should have recommendations");
    
    println!("   Overall Score: {:.2}", compliance_report.overall_score);
    println!("   Violations: {}", compliance_report.violations.len());
    println!("   Recommendations: {}", compliance_report.recommendations.len());

    // Test that we get reasonable compliance data
    assert!(compliance_report.overall_score > 5.0, "Compliance score should be reasonable");

    println!("✅ Compliance reporting tests passed");
} 