#[macro_use]
extern crate songbird_security;

//! Threat Detection Tests for Songbird Security
//!
//! This module contains comprehensive tests for threat detection capabilities
//! including malware detection, phishing prevention, and social engineering protection.

use std::time::SystemTime;

mod test_framework;
use test_framework::*;
use songbird_security::init_beardog_test;

#[tokio::test]
async fn test_advanced_threat_detection() {
    let mut framework = init_beardog_test!("Advanced Threat Detection");

    // Test malware detection
    let malware_scenario = TestThreatScenario {
        scenario_id: "THREAT_001".to_string(),
        threat_type: ThreatType::Malware,
        severity: ThreatSeverity::Critical,
        source: ThreatSource::External,
        target: "family_device_001".to_string(),
        description: "Suspicious executable attempting system modification".to_string(),
        indicators: vec![],
        expected_response: ThreatResponse::Block,
        confidence: 0.8,
        confidence: 0.95, // High confidence detection
    };

    // Test various threat scenarios
    let test_scenarios = vec![
        TestThreatScenario {
            scenario_id: "malware_001".to_string(),
            threat_type: ThreatType::Malware,
            severity: ThreatSeverity::Critical,
            source: ThreatSource::External,
            target: "family_device".to_string(),
            description: "Attempted malware installation on family device".to_string(),
            indicators: vec![
                ThreatIndicator {
                    indicator_type: "file_hash".to_string(),
                    value: "abc123def456".to_string(),
                    confidence: 0.95,
                    timestamp: SystemTime::now(),
                },
            ],
            expected_response: ThreatResponse::Block,
        confidence: 0.8,
        },
        TestThreatScenario {
            scenario_id: "phishing_001".to_string(),
            threat_type: ThreatType::Phishing,
            severity: ThreatSeverity::High,
            source: ThreatSource::External,
            target: "family_email".to_string(),
            description: "Phishing email targeting family member".to_string(),
            indicators: vec![
                ThreatIndicator {
                    indicator_type: "email_domain".to_string(),
                    value: "suspicious-bank.com".to_string(),
                    confidence: 0.88,
                    timestamp: SystemTime::now(),
                },
            ],
            expected_response: ThreatResponse::Block,
        confidence: 0.8,
        },
        TestThreatScenario {
            scenario_id: "social_eng_001".to_string(),
            threat_type: ThreatType::SocialEngineering,
            severity: ThreatSeverity::High,
            source: ThreatSource::Stranger,
            target: "elderly_family_member".to_string(),
            description: "Social engineering attempt targeting elderly family member".to_string(),
            indicators: vec![
                ThreatIndicator {
                    indicator_type: "caller_id".to_string(),
                    value: "fake_tech_support".to_string(),
                    confidence: 0.92,
                    timestamp: SystemTime::now(),
                },
            ],
            expected_response: ThreatResponse::Block,
        confidence: 0.8,
        },
    ];

    // Run threat detection tests
    for scenario in test_scenarios {
        let detected = framework.run_threat_detection_test(scenario.clone()).await;
        assert!(detected, "Should detect threat: {}", scenario.description);
    }
}

/// Test scammer protection specifically
#[tokio::test]
async fn test_scammer_protection() {
    let mut framework = init_beardog_test!("Scammer Protection");

    // Test tech support scam scenarios
    let tech_support_scenarios = vec![
        TestThreatScenario {
            scenario_id: "tech_scam_001".to_string(),
            threat_type: ThreatType::TechnicalSupportScam,
            severity: ThreatSeverity::Critical,
            source: ThreatSource::Stranger,
            target: "grandparent_device".to_string(),
            description: "Fake Microsoft tech support call".to_string(),
            indicators: vec![
                ThreatIndicator {
                    indicator_type: "caller_pattern".to_string(),
                    value: "unsolicited_remote_access".to_string(),
                    confidence: 0.98,
                    timestamp: SystemTime::now(),
                },
            ],
            expected_response: ThreatResponse::Block,
        confidence: 0.8,
        },
        TestThreatScenario {
            scenario_id: "financial_scam_001".to_string(),
            threat_type: ThreatType::SocialEngineering,
            severity: ThreatSeverity::Critical,
            source: ThreatSource::Stranger,
            target: "family_finances".to_string(),
            description: "Fake IRS call demanding payment".to_string(),
            indicators: vec![
                ThreatIndicator {
                    indicator_type: "pressure_tactics".to_string(),
                    value: "urgent_payment_demand".to_string(),
                    confidence: 0.95,
                    timestamp: SystemTime::now(),
                },
            ],
            expected_response: ThreatResponse::Block,
        confidence: 0.8,
        },
    ];

    // Run scammer protection tests
    for scenario in tech_support_scenarios {
        let detected = framework.run_threat_detection_test(scenario.clone()).await;
        assert!(detected, "Should detect scammer threat: {}", scenario.description);
    }
}

/// Test network intrusion detection
#[tokio::test]
async fn test_network_intrusion_detection() {
    let mut framework = init_beardog_test!("Network Intrusion Detection");

    let intrusion_scenarios = vec![
        TestThreatScenario {
            scenario_id: "network_scan_001".to_string(),
            threat_type: ThreatType::NetworkIntrusion,
            severity: ThreatSeverity::High,
            source: ThreatSource::External,
            target: "home_network".to_string(),
            description: "Port scanning detected on home network".to_string(),
            indicators: vec![
                ThreatIndicator {
                    indicator_type: "port_scan".to_string(),
                    value: "sequential_port_access".to_string(),
                    confidence: 0.85,
                    timestamp: SystemTime::now(),
                },
            ],
            expected_response: ThreatResponse::Monitor,
        confidence: 0.8,
        },
        TestThreatScenario {
            scenario_id: "unauthorized_access_001".to_string(),
            threat_type: ThreatType::UnauthorizedAccess,
            severity: ThreatSeverity::Critical,
            source: ThreatSource::External,
            target: "family_router".to_string(),
            description: "Unauthorized access attempt to family router".to_string(),
            indicators: vec![
                ThreatIndicator {
                    indicator_type: "login_attempt".to_string(),
                    value: "brute_force_pattern".to_string(),
                    confidence: 0.92,
                    timestamp: SystemTime::now(),
                },
            ],
            expected_response: ThreatResponse::Block,
        confidence: 0.8,
        },
    ];

    // Run network intrusion detection tests
    for scenario in intrusion_scenarios {
        let detected = framework.run_threat_detection_test(scenario.clone()).await;
        assert!(detected, "Should detect network intrusion: {}", scenario.description);
    }
}

/// Test data exfiltration detection
#[tokio::test]
async fn test_data_exfiltration_detection() {
    let mut framework = init_beardog_test!("Data Exfiltration Detection");

    let exfiltration_scenarios = vec![
        TestThreatScenario {
            scenario_id: "data_exfil_001".to_string(),
            threat_type: ThreatType::DataExfiltration,
            severity: ThreatSeverity::Critical,
            source: ThreatSource::Internal,
            target: "family_documents".to_string(),
            description: "Large file transfer to external server".to_string(),
            indicators: vec![
                ThreatIndicator {
                    indicator_type: "data_transfer".to_string(),
                    value: "large_file_upload".to_string(),
                    confidence: 0.78,
                    timestamp: SystemTime::now(),
                },
            ],
            expected_response: ThreatResponse::Monitor,
        confidence: 0.8,
        },
        TestThreatScenario {
            scenario_id: "credential_theft_001".to_string(),
            threat_type: ThreatType::CredentialStuffing,
            severity: ThreatSeverity::High,
            source: ThreatSource::External,
            target: "family_accounts".to_string(),
            description: "Credential stuffing attack on family accounts".to_string(),
            indicators: vec![
                ThreatIndicator {
                    indicator_type: "login_pattern".to_string(),
                    value: "credential_stuffing".to_string(),
                    confidence: 0.88,
                    timestamp: SystemTime::now(),
                },
            ],
            expected_response: ThreatResponse::Block,
        confidence: 0.8,
        },
    ];

    // Run data exfiltration detection tests
    for scenario in exfiltration_scenarios {
        let detected = framework.run_threat_detection_test(scenario.clone()).await;
        assert!(detected, "Should detect data exfiltration: {}", scenario.description);
    }
} 