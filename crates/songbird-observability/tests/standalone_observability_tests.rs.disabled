#[derive(Debug, Clone, PartialEq)]
enum HealthStatus {
    Healthy,
    Degraded,
    Unhealthy,
    Unknown,
}

#[derive(Debug, Clone)]
struct NetworkIO {
    bytes_sent: u64,
    bytes_received: u64,
    packets_sent: u32,
    packets_received: u32,
    connection_count: u32,
    error_count: u32,
    timestamp: SystemTime,
}

impl NetworkIO {
    fn total_bytes(&self) -> u64 {
        self.bytes_sent + self.bytes_received
    }

    fn total_packets(&self) -> u32 {
        self.packets_sent + self.packets_received
    }

    fn error_rate(&self) -> f64 {
        if self.total_packets() == 0 {
            0.0
        } else {
            self.error_count as f64 / self.total_packets() as f64
        }
    }
}

#[derive(Debug, Clone)]
struct PerformanceMetrics {
    cpu_usage: f64,
    memory_usage: u64,
    disk_usage: u64,
    network_latency: Duration,
    throughput: f64,
    error_rate: f64,
    uptime: Duration,
    timestamp: SystemTime,
}

impl PerformanceMetrics {
    fn sample(cpu: f64, memory: u64, latency: Duration) -> Self {
        Self {
            cpu_usage: cpu,
            memory_usage: memory,
            disk_usage: memory * 2,
            network_latency: latency,
            throughput: 100.0,
            error_rate: 0.01,
            uptime: Duration::from_secs(3600),
            timestamp: SystemTime::now(),
        }
    }

    fn is_cpu_healthy(&self, threshold: f64) -> bool {
        self.cpu_usage < threshold
    }

    fn is_memory_within_limit(&self, limit: u64) -> bool {
        self.memory_usage < limit
    }

    fn is_low_latency(&self, threshold: Duration) -> bool {
        self.network_latency < threshold
    }

    fn with_invalid_cpu(cpu: f64) -> Self {
        Self::sample(cpu, 1000, Duration::from_millis(10))
    }

    fn with_zero_memory(cpu: f64) -> Self {
        Self::sample(cpu, 0, Duration::from_millis(10))
    }

    fn with_negative_latency(cpu: f64) -> Self {
        Self {
            cpu_usage: cpu,
            memory_usage: 1000,
            disk_usage: 2000,
            network_latency: Duration::from_nanos(0), // Represents negative in test
            throughput: 100.0,
            error_rate: 0.01,
            uptime: Duration::from_secs(3600),
            timestamp: SystemTime::now(),
        }
    }
}

// Additional comprehensive helper types...
trait DurationExt {
    fn from_days(days: u64) -> Duration;
}

impl DurationExt for Duration {
    fn from_days(days: u64) -> Duration {
        Duration::from_secs(days * 24 * 3600)
    }
}

#[derive(Debug, Clone)]
struct AlertThresholds {
    cpu_threshold: f64,
    memory_threshold: u64,
    error_rate_threshold: f64,
    latency_threshold: Duration,
}

#[derive(Debug, Clone)]
struct ObservabilityConfig {
    metrics_enabled: bool,
    logging_enabled: bool,
    tracing_enabled: bool,
    collection_interval: Duration,
    retention_period: Duration,
    alert_thresholds: AlertThresholds,
    export_endpoints: Vec<String>,
}

impl ObservabilityConfig {
    fn default() -> Self {
        Self {
            metrics_enabled: true,
            logging_enabled: true,
            tracing_enabled: true,
            collection_interval: Duration::from_secs(60),
            retention_period: Duration::from_days(7),
            alert_thresholds: AlertThresholds {
                cpu_threshold: 80.0,
                memory_threshold: 1024 * 1024 * 1024,
                error_rate_threshold: 0.1,
                latency_threshold: Duration::from_millis(200),
            },
            export_endpoints: vec!["http://localhost:9090".to_string()],
        }
    }

    fn is_valid(&self) -> bool {
        self.collection_interval > Duration::from_secs(0)
            && self.retention_period > Duration::from_secs(0)
            && self.alert_thresholds.cpu_threshold > 0.0
            && self.alert_thresholds.memory_threshold > 0
    }
}

