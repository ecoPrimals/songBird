// Import required observability types
use songbird_config::{LogFormat, LogOutput};
// use songbird_core::api::real_time_ai_streaming::metrics::AlertType; // Circular dependency - define locally

// Local AlertType definition to avoid circular dependency
#[derive(Debug, Clone, PartialEq)]
pub enum AlertType {
    Critical,
    Warning,
    Info,
}
use songbird_errors::{success, SongbirdError};
use songbird_observability::observability::{
    advanced_dashboard::{AlertManager, AlertThresholds},
    dashboard::{Alert, AlertSeverity, ObservabilityDashboard},
};
//
// Comprehensive test coverage for songbird-observability using the proven 7-module framework
// designed to maximize coverage impact without dependency conflicts.

use std::sync::{Arc, Mutex};
use std::time::{Duration, Instant, SystemTime};

/// Module 1: Core Observability Types
mod core_types_tests {
    use super::*;

    #[test]
    fn test_network_io_metrics() {
        let network_io = NetworkIO {
            bytes_sent: 1024,
            bytes_received: 2048,
            packets_sent: 10,
            packets_received: 15,
            connection_count: 5,
            error_count: 2,
            timestamp: SystemTime::now(),
        };

        assert_eq!(network_io.bytes_sent, 1024);
        assert_eq!(network_io.bytes_received, 2048);
        assert_eq!(network_io.packets_sent, 10);
        assert_eq!(network_io.packets_received, 15);
        assert_eq!(network_io.connection_count, 5);
        assert_eq!(network_io.error_count, 2);

        let total_bytes = network_io.total_bytes();
        assert_eq!(total_bytes, 3072); // 1024 + 2048

        let total_packets = network_io.total_packets();
        assert_eq!(total_packets, 25); // 10 + 15

        let error_rate = network_io.error_rate();
        assert_eq!(error_rate, 0.08); // 2 / 25 = 0.08
    }

    #[test]
    fn test_health_status_variants() {
        let health_statuses = vec![
            HealthStatus::Healthy,
            HealthStatus::Degraded,
            HealthStatus::Unhealthy,
            HealthStatus::Unknown,
        ];

        for status in health_statuses {
            let serialized =
                serde_json::to_string(&status).expect("HealthStatus should serialize successfully");
            let deserialized: HealthStatus = serde_json::from_str(&serialized)
                .expect("HealthStatus should deserialize successfully");
            assert_eq!(status, deserialized);
        }
    }

    #[test]
    fn test_performance_metrics() {
        let metrics = PerformanceMetrics {
            cpu_usage: 75.5,
            memory_usage: 1024 * 1024 * 512,    // 512MB
            disk_usage: 1024 * 1024 * 1024 * 2, // 2GB
            network_latency: Duration::from_millis(50),
            throughput: 1000.0,
            error_rate: 0.05,
            uptime: Duration::from_secs(3600), // 1 hour
            timestamp: SystemTime::now(),
        };

        assert_eq!(metrics.cpu_usage, 75.5);
        assert_eq!(metrics.memory_usage, 536_870_912); // 512MB in bytes
        assert_eq!(metrics.disk_usage, 2_147_483_648); // 2GB in bytes
        assert_eq!(metrics.network_latency, Duration::from_millis(50));
        assert_eq!(metrics.throughput, 1000.0);
        assert_eq!(metrics.error_rate, 0.05);
        assert_eq!(metrics.uptime, Duration::from_secs(3600));

        // Test metric calculations
        assert!(metrics.is_cpu_healthy(80.0)); // 75.5 < 80.0
        assert!(!metrics.is_cpu_healthy(70.0)); // 75.5 > 70.0
        assert!(metrics.is_memory_within_limit(1024 * 1024 * 1024)); // 512MB < 1GB
        assert!(metrics.is_low_latency(Duration::from_millis(100))); // 50ms < 100ms
    }

    #[test]
    fn test_observability_config() {
        let config = ObservabilityConfig {
            metrics_enabled: true,
            logging_enabled: true,
            tracing_enabled: true,
            collection_interval: Duration::from_secs(60),
            retention_period: Duration::from_days(7),
            alert_thresholds: AlertThresholds {
                cpu_threshold: 80.0,
                memory_threshold: 1024 * 1024 * 1024, // 1GB
                error_rate_threshold: 0.1,
                latency_threshold: Duration::from_millis(200),
            },
            export_endpoints: vec![
                "http://prometheus:9090".to_string(),
                "http://grafana:3000".to_string(),
            ],
        };

        assert!(config.metrics_enabled);
        assert!(config.logging_enabled);
        assert!(config.tracing_enabled);
        assert_eq!(config.collection_interval, Duration::from_secs(60));
        assert_eq!(config.retention_period, Duration::from_days(7));
        assert_eq!(config.alert_thresholds.cpu_threshold, 80.0);
        assert_eq!(config.export_endpoints.len(), 2);
        assert!(config
            .export_endpoints
            .contains(&"http://prometheus:9090".to_string()));
    }

    #[test]
    fn test_metric_aggregation() {
        let metrics = vec![
            PerformanceMetrics::sample(50.0, 100, Duration::from_millis(10)),
            PerformanceMetrics::sample(60.0, 150, Duration::from_millis(15)),
            PerformanceMetrics::sample(70.0, 200, Duration::from_millis(20)),
        ];

        let aggregated = AggregatedMetrics::from_samples(&metrics);

        assert_eq!(aggregated.sample_count, 3);
        assert_eq!(aggregated.avg_cpu_usage, 60.0); // (50 + 60 + 70) / 3
        assert_eq!(aggregated.avg_memory_usage, 150); // (100 + 150 + 200) / 3
        assert_eq!(aggregated.avg_latency, Duration::from_millis(15)); // (10 + 15 + 20) / 3
        assert_eq!(aggregated.min_cpu_usage, 50.0);
        assert_eq!(aggregated.max_cpu_usage, 70.0);
    }
}

/// Module 2: Metrics Collection Tests
mod metrics_collection_tests {
    use super::*;

    #[test]
    fn test_metrics_collector_creation() {
        let collector = MetricsCollector::new("test-service", Duration::from_secs(30));

        assert_eq!(collector.service_name, "test-service");
        assert_eq!(collector.collection_interval, Duration::from_secs(30));
        assert_eq!(collector.collected_metrics.len(), 0);
        assert!(collector.is_active());
    }

    #[test]
    fn test_metrics_collection() {
        let mut collector = MetricsCollector::new("collection-test", Duration::from_secs(10));

        // Simulate metric collection
        collector.collect_cpu_metrics();
        collector.collect_memory_metrics();
        collector.collect_network_metrics();

        assert!(collector.has_cpu_metrics());
        assert!(collector.has_memory_metrics());
        assert!(collector.has_network_metrics());

        let latest_metrics = collector.get_latest_metrics();
        assert!(latest_metrics.is_some());

        let metrics = latest_metrics.expect("Test should not fail");
        assert!(metrics.cpu_usage >= 0.0 && metrics.cpu_usage <= 100.0);
        assert!(metrics.memory_usage > 0);
        assert!(metrics.network_latency > Duration::from_nanos(0));
    }

    #[test]
    fn test_metrics_storage() {
        let mut storage = MetricsStorage::new(100); // Capacity of 100 metrics

        assert_eq!(storage.capacity(), 100);
        assert_eq!(storage.count(), 0);
        assert!(storage.is_empty());

        // Store metrics
        for i in 0..50 {
            let metrics = PerformanceMetrics::sample(
                50.0 + i as f64,
                1000 + i * 10,
                Duration::from_millis(10 + i),
            );
            storage.store(metrics);
        }

        assert_eq!(storage.count(), 50);
        assert!(!storage.is_empty());
        assert!(!storage.is_full());

        // Test retrieval
        let recent_metrics = storage.get_recent(10);
        assert_eq!(recent_metrics.len(), 10);

        let time_range = storage.get_time_range(
            SystemTime::now() - Duration::from_secs(60),
            SystemTime::now(),
        );
        assert!(!time_range.is_empty());
    }

    #[test]
    fn test_metrics_filtering() {
        let mut storage = MetricsStorage::new(50);

        // Store metrics with varying CPU usage
        for i in 0..20 {
            let cpu_usage = if i % 2 == 0 { 90.0 } else { 30.0 }; // Alternating high/low
            let metrics = PerformanceMetrics::sample(cpu_usage, 1000, Duration::from_millis(10));
            storage.store(metrics);
        }

        let high_cpu_metrics = storage.filter_by_cpu_threshold(80.0);
        assert_eq!(high_cpu_metrics.len(), 10); // Half had 90% CPU

        let low_latency_metrics = storage.filter_by_max_latency(Duration::from_millis(15));
        assert_eq!(low_latency_metrics.len(), 20); // All had 10ms latency

        let error_free_metrics = storage.filter_by_max_error_rate(0.01);
        assert!(!error_free_metrics.is_empty()); // Should have some error-free metrics
    }

    #[tokio::test]
    async fn test_async_metrics_collection() {
        let mut collector = AsyncMetricsCollector::new("async-test", Duration::from_millis(100));

        assert!(!collector.is_running());

        // Start async collection
        collector.start().await;
        assert!(collector.is_running());

        // Let it collect for a short time
        tokio::time::sleep(Duration::from_millis(250)).await;

        let collected_count = collector.get_collection_count();
        assert!(collected_count >= 2); // Should have collected at least 2 times

        collector.stop().await;
        assert!(!collector.is_running());
    }

    #[test]
    fn test_metrics_export() {
        let storage = MetricsStorage::with_sample_data(10);
        let exporter = MetricsExporter::new();

        // Test JSON export
        let json_export = exporter.to_json(&storage);
        assert!(!json_export.is_empty());
        assert!(json_export.contains("cpu_usage"));
        assert!(json_export.contains("memory_usage"));

        // Test Prometheus format export
        let prometheus_export = exporter.to_prometheus(&storage, "test_service");
        assert!(!prometheus_export.is_empty());
        assert!(prometheus_export.contains("# TYPE"));
        assert!(prometheus_export.contains("test_service"));

        // Test CSV export
        let csv_export = exporter.to_csv(&storage);
        assert!(!csv_export.is_empty());
        assert!(csv_export.contains("timestamp,cpu_usage,memory_usage"));
    }
}

/// Module 3: Monitoring and Alerting Tests
mod monitoring_tests {
    use super::*;

    #[test]
    fn test_alert_manager_creation() {
        let alert_config = AlertConfig {
            cpu_threshold: 85.0,
            memory_threshold: 1024 * 1024 * 1024, // 1GB
            error_rate_threshold: 0.15,
            latency_threshold: Duration::from_millis(500),
            consecutive_violations: 3,
        };

        let alert_manager = AlertManager::new(alert_config);

        assert_eq!(alert_manager.config.cpu_threshold, 85.0);
        assert_eq!(alert_manager.config.consecutive_violations, 3);
        assert_eq!(alert_manager.active_alerts.len(), 0);
        assert!(!alert_manager.has_active_alerts());
    }

    #[test]
    fn test_threshold_violations() {
        let alert_config = AlertConfig::default_thresholds();
        let mut alert_manager = AlertManager::new(alert_config);

        // Test CPU threshold violation
        let high_cpu_metrics = PerformanceMetrics::sample(95.0, 500, Duration::from_millis(10));
        let cpu_alert = alert_manager.check_cpu_threshold(&high_cpu_metrics);
        assert!(cpu_alert.is_some());
        assert_eq!(
            cpu_alert.expect("CPU alert should be generated").alert_type,
            AlertType::HighCPU
        );

        // Test memory threshold violation
        let high_memory_metrics =
            PerformanceMetrics::sample(50.0, 2 * 1024 * 1024 * 1024, Duration::from_millis(10)); // 2GB
        let memory_alert = alert_manager.check_memory_threshold(&high_memory_metrics);
        assert!(memory_alert.is_some());
        assert_eq!(
            memory_alert
                .expect("Memory alert should be generated")
                .alert_type,
            AlertType::HighMemory
        );

        // Test latency threshold violation
        let high_latency_metrics = PerformanceMetrics::sample(50.0, 500, Duration::from_secs(1)); // 1 second
        let latency_alert = alert_manager.check_latency_threshold(&high_latency_metrics);
        assert!(latency_alert.is_some());
        assert_eq!(
            latency_alert
                .expect("Latency alert should be generated")
                .alert_type,
            AlertType::HighLatency
        );
    }

    #[test]
    fn test_consecutive_violations() {
        let alert_config = AlertConfig {
            cpu_threshold: 80.0,
            consecutive_violations: 3,
            ..AlertConfig::default_thresholds()
        };
        let mut alert_manager = AlertManager::new(alert_config);

        // Send 2 violations (below threshold for alert)
        for _ in 0..2 {
            let metrics = PerformanceMetrics::sample(85.0, 500, Duration::from_millis(10));
            alert_manager.process_metrics(&metrics);
        }
        assert!(!alert_manager.has_active_alerts());

        // Send 3rd violation (should trigger alert)
        let metrics = PerformanceMetrics::sample(85.0, 500, Duration::from_millis(10));
        alert_manager.process_metrics(&metrics);
        assert!(alert_manager.has_active_alerts());

        let active_alerts = alert_manager.get_active_alerts();
        assert_eq!(active_alerts.len(), 1);
        assert_eq!(active_alerts[0].alert_type, AlertType::HighCPU);
    }

    #[test]
    fn test_alert_recovery() {
        let alert_config = AlertConfig::default_thresholds();
        let mut alert_manager = AlertManager::new(alert_config);

        // Trigger an alert
        let high_cpu_metrics = PerformanceMetrics::sample(95.0, 500, Duration::from_millis(10));
        alert_manager.process_metrics(&high_cpu_metrics);
        alert_manager.process_metrics(&high_cpu_metrics);
        alert_manager.process_metrics(&high_cpu_metrics);

        assert!(alert_manager.has_active_alerts());

        // Send normal metrics to recover
        for _ in 0..3 {
            let normal_metrics = PerformanceMetrics::sample(50.0, 500, Duration::from_millis(10));
            alert_manager.process_metrics(&normal_metrics);
        }

        // Should have recovery alerts but no active critical alerts
        let recovery_alerts = alert_manager.get_recovery_alerts();
        assert!(!recovery_alerts.is_empty());

        let active_alerts = alert_manager.get_active_alerts();
        assert!(
            active_alerts.is_empty()
                || active_alerts
                    .iter()
                    .all(|a| a.severity != AlertSeverity::Critical)
        );
    }

    #[tokio::test]
    async fn test_alert_notifications() {
        let mut notification_system = AlertNotificationSystem::new();

        // Configure notification channels
        notification_system
            .add_channel(NotificationChannel::Email("admin@example.com".to_string()));
        notification_system.add_channel(NotificationChannel::Webhook(
            "http://alerts.example.com/webhook".to_string(),
        ));
        notification_system.add_channel(NotificationChannel::Slack("#alerts".to_string()));

        assert_eq!(notification_system.channel_count(), 3);

        // Create test alert
        let alert = Alert {
            alert_type: AlertType::HighCPU,
            severity: AlertSeverity::Critical,
            message: "CPU usage exceeded 95%".to_string(),
            timestamp: SystemTime::now(),
            service_name: "test-service".to_string(),
            metric_value: 96.5,
        };

        // Send notification
        let notification_result = notification_system.send_alert(&alert).await;
        assert!(notification_result.is_ok());

        let notification_count = notification_result.expect("Test should not fail");
        assert_eq!(notification_count, 3); // Should notify all 3 channels
    }

    #[test]
    fn test_monitoring_dashboard() {
        let mut dashboard = MonitoringDashboard::new("Test Dashboard");

        assert_eq!(dashboard.name, "Test Dashboard");
        assert_eq!(dashboard.widget_count(), 0);

        // Add monitoring widgets
        dashboard.add_widget(DashboardWidget::CPUGraph);
        dashboard.add_widget(DashboardWidget::MemoryGraph);
        dashboard.add_widget(DashboardWidget::NetworkGraph);
        dashboard.add_widget(DashboardWidget::AlertList);

        assert_eq!(dashboard.widget_count(), 4);
        assert!(dashboard.has_widget(DashboardWidget::CPUGraph));
        assert!(dashboard.has_widget(DashboardWidget::AlertList));

        // Generate dashboard data
        let sample_metrics = MetricsStorage::with_sample_data(20);
        let dashboard_data = dashboard.generate_data(&sample_metrics);

        assert!(!dashboard_data.cpu_data.is_empty());
        assert!(!dashboard_data.memory_data.is_empty());
        assert!(!dashboard_data.network_data.is_empty());
        assert!(dashboard_data.timestamp_range.is_valid());
    }
}

/// Module 4: Logging and Tracing Tests
mod logging_tests {
    use super::*;

    #[test]
    fn test_structured_logger_creation() {
        let logger_config = LoggerConfig {
            level: LogLevel::Info,
            format: LogFormat::Json,
            output: LogOutput::File("test.log".to_string()),
            include_timestamps: true,
            include_source_location: true,
            buffer_size: 1000,
        };

        let logger = StructuredLogger::new(logger_config);

        assert_eq!(logger.config.level, LogLevel::Info);
        assert_eq!(logger.config.format, LogFormat::Json);
        assert!(logger.config.include_timestamps);
        assert_eq!(logger.config.buffer_size, 1000);
    }

    #[test]
    fn test_log_level_filtering() {
        let mut logger = StructuredLogger::with_level(LogLevel::Warn);

        // These should be logged (Warn level and above)
        logger.error("Error message", &[("error_code", "500")]);
        logger.warn("Warning message", &[("component", "network")]);

        // These should be filtered out (below Warn level)
        logger.info("Info message", &[("status", "ok")]);
        logger.debug("Debug message", &[("debug_info", "detailed")]);

        let log_entries = logger.get_entries();
        assert_eq!(log_entries.len(), 2); // Only error and warn should be present

        assert_eq!(log_entries[0].level, LogLevel::Error);
        assert_eq!(log_entries[1].level, LogLevel::Warn);
    }

    #[test]
    fn test_structured_logging() {
        let mut logger = StructuredLogger::with_level(LogLevel::Debug);

        logger.info(
            "User login",
            &[
                ("user_id", "12345"),
                ("ip_address", "192.168.1.100"),
                ("user_agent", "Mozilla/5.0"),
                (
                    "timestamp",
                    &SystemTime::now()
                        .duration_since(SystemTime::UNIX_EPOCH)
                        .expect("Observability configuration should be valid")
                        .as_secs()
                        .to_string(),
                ),
            ],
        );

        let entries = logger.get_entries();
        assert_eq!(entries.len(), 1);

        let entry = &entries[0];
        assert_eq!(entry.message, "User login");
        assert_eq!(entry.level, LogLevel::Info);
        assert!(entry.fields.contains_key("user_id"));
        assert_eq!(entry.fields["user_id"], "12345");
        assert!(entry.fields.contains_key("ip_address"));
    }

    #[test]
    fn test_log_formatting() {
        let logger = StructuredLogger::with_format(LogFormat::Json);

        let entry = LogEntry {
            timestamp: SystemTime::now(),
            level: LogLevel::Info,
            message: "Test message".to_string(),
            fields: [
                ("key1".to_string(), "value1".to_string()),
                ("key2".to_string(), "value2".to_string()),
            ]
            .iter()
            .cloned()
            .collect(),
            source_location: Some("test.rs:123".to_string()),
        };

        let json_output = logger.format_entry(&entry);
        assert!(json_output.contains("\"message\":\"Test message\""));
        assert!(json_output.contains("\"level\":\"info\""));
        assert!(json_output.contains("\"key1\":\"value1\""));
        assert!(json_output.contains("\"source_location\":\"test.rs:123\""));

        // Test plain text formatting
        let plain_logger = StructuredLogger::with_format(LogFormat::Plain);
        let plain_output = plain_logger.format_entry(&entry);
        assert!(plain_output.contains("INFO"));
        assert!(plain_output.contains("Test message"));
        assert!(plain_output.contains("key1=value1"));
    }

    #[tokio::test]
    async fn test_async_logging() {
        let mut async_logger = AsyncLogger::new(LogLevel::Debug, 100);

        assert!(!async_logger.is_running());

        // Start async logging
        async_logger.start().await;
        assert!(async_logger.is_running());

        // Log messages asynchronously
        for i in 0..10 {
            async_logger
                .log_async(
                    LogLevel::Info,
                    &format!("Async message {}", i),
                    &[("iteration", &i.to_string()), ("thread", "async")],
                )
                .await;
        }

        // Allow time for processing
        tokio::time::sleep(Duration::from_millis(100)).await;

        let processed_count = async_logger.get_processed_count();
        assert!(processed_count >= 10);

        async_logger.stop().await;
        assert!(!async_logger.is_running());
    }

    #[test]
    fn test_log_rotation() {
        let mut rotating_logger = RotatingLogger::new(
            "test_rotation.log",
            1024, // 1KB max file size
            5,    // Keep 5 files
        );

        // Generate enough logs to trigger rotation
        for i in 0..100 {
            rotating_logger.info(&format!("This is a test log message number {} with some additional content to make it longer", i), &[]);
        }

        let current_file_size = rotating_logger.current_file_size();
        assert!(current_file_size <= 1024); // Should not exceed max size

        let rotated_files = rotating_logger.list_rotated_files();
        assert!(!rotated_files.is_empty()); // Should have rotated files
        assert!(rotated_files.len() <= 5); // Should not exceed max files
    }
}

/// Module 5: Performance and Integration Tests
mod performance_integration_tests {
    use super::*;

    #[test]
    fn test_high_volume_metrics_collection() {
        let mut collector = MetricsCollector::new("performance-test", Duration::from_millis(1));
        let mut storage = MetricsStorage::new(10000);

        let start = Instant::now();

        // Collect high volume of metrics
        for i in 0..1000 {
            let metrics = PerformanceMetrics::sample(
                50.0 + (i as f64 % 50.0),
                1000 + i * 10,
                Duration::from_micros(100 + i),
            );
            storage.store(metrics);
        }

        let duration = start.elapsed();
        assert!(
            duration < Duration::from_millis(100),
            "High volume collection should be fast"
        );

        assert_eq!(storage.count(), 1000);

        // Test aggregation performance
        let aggregation_start = Instant::now();
        let aggregated = AggregatedMetrics::from_storage(&storage);
        let aggregation_duration = aggregation_start.elapsed();

        assert!(
            aggregation_duration < Duration::from_millis(50),
            "Aggregation should be fast"
        );
        assert_eq!(aggregated.sample_count, 1000);
    }

    #[tokio::test]
    async fn test_concurrent_metrics_processing() {
        let storage = Arc::new(Mutex::new(MetricsStorage::new(1000)));
        let mut handles = vec![];

        // Spawn concurrent metric generators
        for worker_id in 0..10 {
            let storage_clone = Arc::clone(&storage);
            let handle = tokio::spawn(async move {
                for i in 0..50 {
                    let metrics = PerformanceMetrics::sample(
                        40.0 + worker_id as f64,
                        1000 + i * worker_id,
                        Duration::from_millis(10 + worker_id),
                    );

                    {
                        let mut storage_guard = storage_clone.lock().await;
                        storage_guard.store(metrics);
                    }

                    tokio::time::sleep(Duration::from_millis(1)).await;
                }
                worker_id
            });
            handles.push(handle);
        }

        // Wait for all workers to complete
        let mut results = Vec::new();
        for handle in handles {
            results.push(handle.await);
        }

        assert_eq!(results.len(), 10);
        for result in results {
            assert!(result.is_ok());
        }

        let final_storage = storage.lock().await;
        assert_eq!(final_storage.count(), 500); // 10 workers * 50 metrics each
    }

    #[test]
    fn test_memory_efficiency() {
        let initial_memory = get_memory_usage();

        // Create large metrics storage
        let mut storage = MetricsStorage::new(10000);

        // Fill with metrics
        for i in 0..5000 {
            let metrics = PerformanceMetrics::sample(50.0, 1000, Duration::from_millis(10));
            storage.store(metrics);
        }

        let peak_memory = get_memory_usage();
        let memory_increase = peak_memory - initial_memory;

        // Should not use excessive memory (rough estimate)
        assert!(
            memory_increase < 100 * 1024 * 1024,
            "Memory usage should be reasonable"
        ); // Less than 100MB

        // Test cleanup
        storage.clear();
        let after_cleanup_memory = get_memory_usage();

        // Memory should be released (allowing for some overhead)
        assert!(
            after_cleanup_memory < peak_memory,
            "Memory should be released after cleanup"
        );
    }

    #[tokio::test]
    async fn test_end_to_end_observability_pipeline() {
        // Setup complete observability pipeline
        let config = ObservabilityConfig::default();
        let mut pipeline = ObservabilityPipeline::new(config);

        // Start pipeline components
        pipeline.start_metrics_collection().await;
        pipeline.start_logging().await;
        pipeline.start_alerting().await;

        assert!(pipeline.is_running());

        // Generate test workload
        for i in 0..20 {
            // Simulate varying system load
            let cpu_load = if i > 15 { 90.0 } else { 50.0 }; // High load near end
            let memory_usage = 1000 + i * 50;
            let latency = Duration::from_millis(if i > 15 { 200 } else { 50 });

            pipeline
                .record_metrics(cpu_load, memory_usage, latency)
                .await;
            pipeline
                .log_event(
                    LogLevel::Info,
                    &format!("Processing item {}", i),
                    &[
                        ("item_id", &i.to_string()),
                        ("cpu_load", &cpu_load.to_string()),
                    ],
                )
                .await;

            tokio::time::sleep(Duration::from_millis(10)).await;
        }

        // Allow processing time
        tokio::time::sleep(Duration::from_millis(200)).await;

        // Verify pipeline results
        let collected_metrics = pipeline.get_collected_metrics();
        assert!(collected_metrics.len() >= 15); // Should have collected most metrics

        let log_entries = pipeline.get_log_entries();
        assert!(log_entries.len() >= 15); // Should have logged most events

        let triggered_alerts = pipeline.get_triggered_alerts();
        assert!(!triggered_alerts.is_empty()); // Should have triggered alerts for high CPU

        // Verify alert content
        let cpu_alerts: Vec<_> = triggered_alerts
            .iter()
            .filter(|alert| alert.alert_type == AlertType::HighCPU)
            .collect();
        assert!(!cpu_alerts.is_empty());

        // Stop pipeline
        pipeline.stop().await;
        assert!(!pipeline.is_running());
    }

    #[test]
    fn test_metrics_export_formats() {
        let storage = MetricsStorage::with_sample_data(50);
        let exporter = MetricsExporter::new();

        // Test multiple export formats
        let formats = vec![
            ExportFormat::Json,
            ExportFormat::Prometheus,
            ExportFormat::InfluxDB,
            ExportFormat::CSV,
        ];

        for format in formats {
            let export_start = Instant::now();
            let exported_data = exporter.export(&storage, format);
            let export_duration = export_start.elapsed();

            assert!(
                !exported_data.is_empty(),
                "Export should produce data for format: {:?}",
                format
            );
            assert!(
                export_duration < Duration::from_millis(100),
                "Export should be fast for format: {:?}",
                format
            );

            // Verify format-specific content
            match format {
                ExportFormat::Json => {
                    assert!(exported_data.contains("\"cpu_usage\""));
                    assert!(exported_data.contains("\"timestamp\""));
                }
                ExportFormat::Prometheus => {
                    assert!(exported_data.contains("# TYPE"));
                    assert!(exported_data.contains("_total"));
                }
                ExportFormat::InfluxDB => {
                    assert!(exported_data.contains("cpu_usage="));
                    assert!(exported_data.contains("memory_usage="));
                }
                ExportFormat::CSV => {
                    assert!(exported_data.contains("timestamp,cpu_usage"));
                    assert!(exported_data.lines().count() > 1);
                }
            }
        }
    }
}

/// Module 6: Error Handling and Edge Cases
mod error_handling_tests {
    use super::*;

    #[test]
    fn test_invalid_metrics_handling() {
        let mut storage = MetricsStorage::new(100);

        // Test with invalid/extreme values
        let invalid_metrics = vec![
            PerformanceMetrics::with_invalid_cpu(-10.0), // Negative CPU
            PerformanceMetrics::with_invalid_cpu(150.0), // CPU > 100%
            PerformanceMetrics::with_zero_memory(50.0),  // Zero memory
            PerformanceMetrics::with_negative_latency(50.0), // Negative latency
        ];

        for metrics in invalid_metrics {
            let result = storage.try_store(metrics);
            // Should either reject invalid metrics or sanitize them
            assert!(result.is_ok() || result.is_err());

            if result.is_ok() {
                // If accepted, values should be sanitized
                let stored_metrics = storage.get_latest().expect("Test should not fail");
                assert!(stored_metrics.cpu_usage >= 0.0 && stored_metrics.cpu_usage <= 100.0);
                assert!(stored_metrics.memory_usage >= 0);
                assert!(stored_metrics.network_latency >= Duration::from_nanos(0));
            }
        }
    }

    #[test]
    fn test_storage_overflow_handling() {
        let mut storage = MetricsStorage::new(5); // Very small capacity

        // Fill beyond capacity
        for i in 0..10 {
            let metrics = PerformanceMetrics::sample(50.0, 1000, Duration::from_millis(10));
            storage.store(metrics);
        }

        // Should not exceed capacity
        assert!(storage.count() <= 5);

        // Should maintain most recent metrics
        let latest_metrics = storage.get_recent(3);
        assert_eq!(latest_metrics.len(), 3);

        // Test that oldest metrics were evicted
        let all_metrics = storage.get_all();
        assert!(all_metrics.len() <= 5);
    }

    #[test]
    fn test_concurrent_access_safety() {
        use std::sync::Arc;
        use std::sync::Mutex;
        use std::thread;

        let storage = Arc::new(Mutex::new(MetricsStorage::new(1000)));
        let mut handles = vec![];

        // Spawn concurrent readers and writers
        for worker_id in 0..5 {
            let storage_clone = Arc::clone(&storage);
            let handle = thread::spawn(move || {
                for i in 0..100 {
                    let metrics = PerformanceMetrics::sample(
                        50.0 + worker_id as f64,
                        1000 + i,
                        Duration::from_millis(10),
                    );

                    // Write
                    {
                        let mut storage_guard = storage_clone.lock().map_err(|e| {
                            SongbirdError::runtime_error(&format!("Lock acquisition failed: {}", e))
                        })?;
                        storage_guard.store(metrics);
                    }

                    // Read
                    {
                        let storage_guard = storage_clone.lock().map_err(|e| {
                            SongbirdError::runtime_error(&format!("Lock acquisition failed: {}", e))
                        })?;
                        let _latest = storage_guard.get_latest();
                        let _count = storage_guard.count();
                    }
                }
                worker_id
            });
            handles.push(handle);
        }

        // Wait for all threads
        for handle in handles {
            let result = handle.join();
            assert!(result.is_ok());
        }

        let final_storage = storage.lock().map_err(|e| {
            SongbirdError::runtime_error(&format!("Lock acquisition failed: {}", e))
        })?;
        assert!(final_storage.count() > 0);
        assert!(final_storage.count() <= 500); // 5 workers * 100 operations
    }

    #[tokio::test]
    async fn test_alert_system_failure_recovery() {
        let mut alert_manager = AlertManager::new(AlertConfig::default_thresholds());
        let mut notification_system = AlertNotificationSystem::new();

        // Add a failing notification channel
        notification_system.add_channel(NotificationChannel::Webhook(
            "http://invalid-url".to_string(),
        ));
        notification_system
            .add_channel(NotificationChannel::Email("valid@example.com".to_string()));

        // Trigger alert
        let alert = Alert::high_cpu("test-service", 95.0);

        let notification_result = notification_system.send_alert(&alert).await;

        // Should handle partial failures gracefully
        assert!(notification_result.is_ok() || notification_result.is_err());

        // System should continue operating despite failures
        let health_status = notification_system.get_health_status();
        assert!(health_status.is_partially_healthy() || health_status.is_healthy());
    }

    #[test]
    fn test_log_system_error_recovery() {
        let mut logger =
            StructuredLogger::with_output(LogOutput::File("/invalid/path/test.log".to_string()));

        // Should handle file creation failures gracefully
        let log_result = logger.error("Test error message", &[("key", "value")]);

        // Should either succeed with fallback or fail gracefully
        assert!(log_result.is_ok() || log_result.is_err());

        // Logger should remain functional
        assert!(logger.is_operational() || logger.has_fallback());

        // Test recovery with valid output
        logger.set_output(LogOutput::Memory);
        let recovery_result = logger.info("Recovery test", &[]);
        assert!(recovery_result.is_ok());
    }

    #[test]
    fn test_resource_cleanup_on_error() {
        let mut resource_manager = ObservabilityResourceManager::new();

        // Allocate resources
        let collector_id = resource_manager.create_metrics_collector("test");
        let logger_id = resource_manager.create_logger("test-logger");
        let alert_id = resource_manager.create_alert_manager("test-alerts");

        assert_eq!(resource_manager.active_resources(), 3);

        // Simulate error condition
        resource_manager.simulate_error_condition();

        // Resources should be cleaned up
        assert!(resource_manager.active_resources() == 0 || resource_manager.in_error_state());

        // Should be able to recover
        let recovery_result = resource_manager.recover_from_error();
        assert!(recovery_result.is_ok());

        // Should be able to create new resources after recovery
        let new_collector_id = resource_manager.create_metrics_collector("recovery-test");
        assert!(new_collector_id.is_some());
    }
}

/// Module 7: Comprehensive Edge Cases
mod comprehensive_edge_cases {
    use super::*;

    #[test]
    fn test_unicode_and_special_characters() {
        let mut logger = StructuredLogger::with_level(LogLevel::Debug);

        // Test with various unicode and special characters
        let unicode_messages = vec![
            "测试消息 with Chinese characters",
            "🎵 Songbird observability with emojis 🚀",
            "Русский текст with Cyrillic",
            "العربية with Arabic script",
            "Special chars: !@#$%^&*()[]{}|\\:;\"'<>?/.,~`",
            "Newlines\nand\ttabs\rand\x00null bytes",
        ];

        for message in unicode_messages {
            let result = logger.info(
                message,
                &[("unicode_test", "true"), ("message_type", "special_chars")],
            );
            assert!(result.is_ok(), "Should handle unicode message: {}", message);
        }

        let entries = logger.get_entries();
        assert_eq!(entries.len(), unicode_messages.len());

        // Verify entries contain expected content
        for (i, entry) in entries.iter().enumerate() {
            assert!(entry
                .message
                .contains(&unicode_messages[i][..std::cmp::min(10, unicode_messages[i].len())]));
        }
    }

    #[test]
    fn test_extreme_timestamp_values() {
        let mut storage = MetricsStorage::new(100);

        // Test with extreme timestamp values
        let extreme_timestamps = vec![
            SystemTime::UNIX_EPOCH, // Minimum timestamp
            SystemTime::UNIX_EPOCH + Duration::from_secs(u32::MAX as u64), // Far future
            SystemTime::now() - Duration::from_secs(365 * 24 * 3600), // 1 year ago
            SystemTime::now() + Duration::from_secs(365 * 24 * 3600), // 1 year future
        ];

        for timestamp in extreme_timestamps {
            let metrics = PerformanceMetrics {
                cpu_usage: 50.0,
                memory_usage: 1000,
                disk_usage: 5000,
                network_latency: Duration::from_millis(10),
                throughput: 100.0,
                error_rate: 0.01,
                uptime: Duration::from_secs(3600),
                timestamp,
            };

            let result = storage.try_store(metrics);
            assert!(
                result.is_ok(),
                "Should handle extreme timestamp: {:?}",
                timestamp
            );
        }

        // Verify storage can handle time range queries with extreme values
        let all_metrics = storage.get_time_range(
            SystemTime::UNIX_EPOCH,
            SystemTime::now() + Duration::from_secs(365 * 24 * 3600 * 10), // 10 years future
        );
        assert!(!all_metrics.is_empty());
    }

    #[test]
    fn test_very_large_metric_values() {
        let mut storage = MetricsStorage::new(10);

        // Test with very large values
        let large_values = vec![
            (f64::MAX, u64::MAX, Duration::from_secs(u64::MAX / 1000)),
            (0.0, 0, Duration::from_nanos(0)),
            (
                100.0,
                1024 * 1024 * 1024 * 1024,
                Duration::from_secs(365 * 24 * 3600),
            ), // 1TB, 1 year
        ];

        for (cpu, memory, latency) in large_values {
            let metrics = PerformanceMetrics {
                cpu_usage: cpu,
                memory_usage: memory,
                disk_usage: memory * 2,
                network_latency: latency,
                throughput: if cpu.is_finite() {
                    cpu * 1000.0
                } else {
                    1000.0
                },
                error_rate: 0.0,
                uptime: latency,
                timestamp: SystemTime::now(),
            };

            let result = storage.try_store(metrics);
            // Should handle or sanitize extreme values
            assert!(result.is_ok() || result.is_err());
        }
    }

    #[test]
    fn test_rapid_configuration_changes() {
        let mut config_manager = ObservabilityConfigManager::new();

        // Rapidly change configuration
        for i in 0..100 {
            let new_config = ObservabilityConfig {
                metrics_enabled: i % 2 == 0,
                logging_enabled: i % 3 == 0,
                tracing_enabled: i % 5 == 0,
                collection_interval: Duration::from_millis(10 + i),
                retention_period: Duration::from_secs(3600 + i * 60),
                alert_thresholds: AlertThresholds {
                    cpu_threshold: 50.0 + (i as f64 % 50.0),
                    memory_threshold: 1024 * 1024 * (100 + i),
                    error_rate_threshold: 0.01 + (i as f64 / 10000.0),
                    latency_threshold: Duration::from_millis(100 + i),
                },
                export_endpoints: vec![format!("http://endpoint-{}.example.com", i)],
            };

            let result = config_manager.update_config(new_config);
            assert!(result.is_ok(), "Should handle rapid config change {}", i);
        }

        // Verify final state is consistent
        let final_config = config_manager.get_current_config();
        assert!(final_config.is_valid());
    }

    #[tokio::test]
    async fn test_system_resource_exhaustion_simulation() {
        let mut resource_monitor = SystemResourceMonitor::new();

        // Simulate various resource exhaustion scenarios
        let exhaustion_scenarios = vec![
            ResourceExhaustionScenario::HighCPU(99.9),
            ResourceExhaustionScenario::HighMemory(95.0),
            ResourceExhaustionScenario::HighDisk(98.0),
            ResourceExhaustionScenario::NetworkSaturation(1000.0), // 1000 Mbps
            ResourceExhaustionScenario::FileDescriptorLimit(65535),
        ];

        for scenario in exhaustion_scenarios {
            resource_monitor.simulate_scenario(scenario.clone()).await;

            // System should detect and handle exhaustion
            let detection_result = resource_monitor.detect_exhaustion().await;
            assert!(detection_result.is_exhausted_for(scenario.resource_type()));

            // Should trigger appropriate alerts
            let alerts = resource_monitor.get_exhaustion_alerts();
            assert!(!alerts.is_empty());

            // Should attempt recovery
            let recovery_result = resource_monitor
                .attempt_recovery(scenario.resource_type())
                .await;
            assert!(recovery_result.is_ok() || recovery_result.is_err()); // Either outcome is acceptable

            // Reset for next test
            resource_monitor.reset_simulation().await;
        }
    }

    #[test]
    fn test_malformed_configuration_handling() {
        let config_parser = ObservabilityConfigParser::new();

        // Test various malformed configurations
        let malformed_configs = vec![
            r#"{"metrics_enabled": "not_a_boolean"}"#,
            r#"{"collection_interval": -1}"#,
            r#"{"alert_thresholds": {"cpu_threshold": "invalid"}}"#,
            r#"{"export_endpoints": "should_be_array"}"#,
            r#"{"unknown_field": "value"}"#,
            r#"{"retention_period": null}"#,
            r#"{malformed json}"#,
            r#""#, // Empty string
        ];

        for malformed_config in malformed_configs {
            let parse_result = config_parser.parse(malformed_config);

            // Should handle malformed config gracefully
            assert!(
                parse_result.is_err()
                    || parse_result
                        .expect("Parse result should be valid")
                        .is_valid_with_defaults()
            );
        }

        // Should provide helpful error messages
        let error_result = config_parser.parse(r#"{"metrics_enabled": "invalid"}"#);
        if let Err(error) = error_result {
            assert!(!error.message().is_empty());
            assert!(error.has_suggestions());
        }
    }

    #[test]
    fn test_circular_dependency_detection() {
        let mut dependency_manager = ObservabilityDependencyManager::new();

        // Create components with dependencies
        dependency_manager.register_component("metrics_collector", vec!["storage", "config"]);
        dependency_manager
            .register_component("alert_manager", vec!["metrics_collector", "notification"]);
        dependency_manager.register_component("notification", vec!["config", "logger"]);
        dependency_manager.register_component("logger", vec!["config"]);
        dependency_manager.register_component("storage", vec!["config"]);
        dependency_manager.register_component("config", vec![]);

        // Verify no circular dependencies in valid setup
        let cycle_check = dependency_manager.check_for_cycles();
        assert!(cycle_check.is_ok());

        // Introduce circular dependency
        dependency_manager.add_dependency("config", "metrics_collector"); // Creates cycle

        let cycle_check_with_cycle = dependency_manager.check_for_cycles();
        assert!(cycle_check_with_cycle.is_err());

        let cycles = cycle_check_with_cycle.unwrap_err();
        assert!(!cycles.is_empty());
        assert!(cycles[0].contains("config") && cycles[0].contains("metrics_collector"));
    }

    #[test]
    fn test_graceful_degradation() {
        let mut observability_system = ObservabilitySystem::new();

        // Start with full functionality
        observability_system.enable_all_features();
        assert!(observability_system.is_fully_functional());

        // Simulate component failures
        observability_system.simulate_component_failure("metrics_storage");
        assert!(observability_system.is_degraded());
        assert!(observability_system.has_basic_functionality()); // Should still work with reduced features

        observability_system.simulate_component_failure("alert_manager");
        assert!(observability_system.is_degraded());
        assert!(observability_system.has_basic_functionality()); // Should still log and collect some metrics

        observability_system.simulate_component_failure("logger");
        assert!(observability_system.is_severely_degraded());
        assert!(observability_system.has_minimal_functionality()); // Should have bare minimum

        // Test recovery
        observability_system.recover_component("logger");
        assert!(observability_system.is_degraded()); // Better but not fully recovered

        observability_system.recover_component("metrics_storage");
        observability_system.recover_component("alert_manager");
        assert!(observability_system.is_fully_functional()); // Should be back to normal
    }
}

