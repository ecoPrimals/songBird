    }

    fn collect_memory_metrics(&mut self) {
        // Mock implementation
    }

    fn collect_network_metrics(&mut self) {
        // Mock implementation
    }

    fn has_cpu_metrics(&self) -> bool {
        true
    }
    fn has_memory_metrics(&self) -> bool {
        true
    }
    fn has_network_metrics(&self) -> bool {
        true
    }

    fn get_latest_metrics(&self) -> Option<PerformanceMetrics> {
        Some(PerformanceMetrics::sample(
            50.0,
            1000,
            Duration::from_millis(10),
        ))
    }
}

#[derive(Debug)]
struct MetricsStorage {
    capacity: usize,
    metrics: Vec<PerformanceMetrics>,
}

impl MetricsStorage {
    fn new(capacity: usize) -> Self {
        Self {
            capacity,
            metrics: Vec::new(),
        }
    }

    fn capacity(&self) -> usize {
        self.capacity
    }
    fn count(&self) -> usize {
        self.metrics.len()
    }
    fn is_empty(&self) -> bool {
        self.metrics.is_empty()
    }
    fn is_full(&self) -> bool {
        self.metrics.len() >= self.capacity
    }

    fn store(&mut self, metrics: PerformanceMetrics) {
        if self.metrics.len() >= self.capacity {
            self.metrics.remove(0); // Remove oldest
        }
        self.metrics.push(metrics);
    }

    fn try_store(&mut self, metrics: PerformanceMetrics) -> Result<(), &'static str> {
        // Validate metrics
        if metrics.cpu_usage < 0.0 || metrics.cpu_usage > 100.0 {
            return Err("Invalid CPU usage");
        }
        if metrics.memory_usage == 0 {
            return Err("Invalid memory usage");
        }

        self.store(metrics);
        Ok(())
    }

    fn get_recent(&self, count: usize) -> Vec<&PerformanceMetrics> {
        let start = if self.metrics.len() > count {
            self.metrics.len() - count
        } else {
            0
        };
        self.metrics[start..].iter().collect()
    }

    fn get_latest(&self) -> Option<&PerformanceMetrics> {
        self.metrics.last()
    }

    fn get_all(&self) -> &Vec<PerformanceMetrics> {
        &self.metrics
    }

    fn get_time_range(&self, start: SystemTime, end: SystemTime) -> Vec<&PerformanceMetrics> {
        self.metrics
            .iter()
            .filter(|m| m.timestamp >= start && m.timestamp <= end)
            .collect()
    }

    fn filter_by_cpu_threshold(&self, threshold: f64) -> Vec<&PerformanceMetrics> {
        self.metrics
            .iter()
            .filter(|m| m.cpu_usage >= threshold)
            .collect()
    }

    fn filter_by_max_latency(&self, max_latency: Duration) -> Vec<&PerformanceMetrics> {
        self.metrics
            .iter()
            .filter(|m| m.network_latency <= max_latency)
            .collect()
    }

    fn filter_by_max_error_rate(&self, max_error_rate: f64) -> Vec<&PerformanceMetrics> {
        self.metrics
            .iter()
            .filter(|m| m.error_rate <= max_error_rate)
            .collect()
    }

    fn clear(&mut self) {
        self.metrics.clear();
    }

    fn with_sample_data(count: usize) -> Self {
        let mut storage = Self::new(count * 2);
        for i in 0..count {
            let metrics = PerformanceMetrics::sample(
                50.0 + (i as f64 % 50.0),
                1000 + i * 10,
                Duration::from_millis(10 + i as u64),
            );
            storage.store(metrics);
        }
        storage
    }
}

