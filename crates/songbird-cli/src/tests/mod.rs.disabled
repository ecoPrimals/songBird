/// Comprehensive CLI Test Suite
///
/// This module provides comprehensive testing for all CLI commands and functionality,
/// significantly boosting test coverage and ensuring CLI reliability.
pub mod command_tests;
pub mod config_tests;
pub mod error_handling_tests;
pub mod integration_tests;
pub mod output_format_tests;

use clap::Command;
use songbird_errors::SongbirdResult;
use std::process::Command as ProcessCommand;
use tempfile::TempDir;

/// Test utilities for CLI testing
pub struct CliTestContext {
    pub temp_dir: TempDir,
    pub config_path: std::path::PathBuf,
}

impl CliTestContext {
    pub fn new() -> SongbirdResult<Self> {
        let temp_dir = TempDir::new().map_err(|e| {
            songbird_errors::SongbirdError::io_error(format!("Failed to create temp dir: {}", e))
        })?;
        let config_path = temp_dir.path().join("songbird-config.toml");

        // Create a minimal test config
        std::fs::write(
            &config_path,
            r#"
[global]
service_name = "test-songbird"
log_level = "info"

[network]
bind_address = "127.0.0.1:0"
port = 0

[federation]
node_name = "test-node"
discovery_enabled = false
"#,
        )
        .map_err(|e| {
            songbird_errors::SongbirdError::io_error(format!("Failed to write config: {}", e))
        })?;

        Ok(Self {
            temp_dir,
            config_path,
        })
    }
}

/// Helper function to create CLI command for testing
pub fn create_test_cli() -> Command {
    Command::new("songbird-test")
        .about("Test CLI")
        .version("test")
}

/// Helper to run CLI command and capture output
pub fn run_cli_command(args: &[&str]) -> Result<(String, String, i32), Box<dyn std::error::Error>> {
    let output = ProcessCommand::new("cargo")
        .args(&["run", "--bin", "songbird", "--"])
        .args(args)
        .output()?;

    Ok((
        String::from_utf8_lossy(&output.stdout).to_string(),
        String::from_utf8_lossy(&output.stderr).to_string(),
        output.status.code().unwrap_or(-1),
    ))
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_cli_structure() {
        let cli = create_test_cli();

        // Verify main CLI structure
        assert_eq!(cli.get_name(), "songbird");

        // Verify subcommands exist
        let subcommands: Vec<&str> = cli.get_subcommands().map(|cmd| cmd.get_name()).collect();

        // Check for key commands
        assert!(subcommands.contains(&"version"));
        assert!(subcommands.contains(&"status"));
        assert!(subcommands.contains(&"quick"));
        assert!(subcommands.contains(&"join"));
        assert!(subcommands.contains(&"share"));
    }

    #[test]
    fn test_cli_help_generation() {
        let cli = create_test_cli();
        let help = cli.render_help();

        // Verify help contains key information
        assert!(help.to_string().contains("Songbird"));
        assert!(help.to_string().contains("Universal Orchestrator"));
    }
}
