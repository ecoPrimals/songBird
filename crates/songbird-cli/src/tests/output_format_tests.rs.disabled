//! Output Format Tests
//!
//! Tests for CLI output formatting functionality

use super::*;
use crate::cli::output::OutputFormat;
use serde_json::Value;

#[cfg(test)]
mod output_format_tests {

    #[test]
    fn test_json_output_format() {
        let data = serde_json::json!({
            "status": "success",
            "message": "Test message"
        });

        let formatted = OutputFormat::Json
            .format_output(&data)
            .expect("Test should not fail");
        assert!(formatted.contains("\"status\":\"success\""));
        assert!(formatted.contains("\"message\":\"Test message\""));
    }

    #[test]
    fn test_yaml_output_format() {
        let data = serde_json::json!({
            "status": "success",
            "count": 42
        });

        let formatted = OutputFormat::Yaml
            .format_output(&data)
            .expect("Test should not fail");
        assert!(formatted.contains("status: success"));
        assert!(formatted.contains("count: 42"));
    }

    #[test]
    fn test_table_output_format() {
        let data = serde_json::json!([
            {"name": "service1", "status": "running"},
            {"name": "service2", "status": "stopped"}
        ]);

        let formatted = OutputFormat::Table
            .format_output(&data)
            .expect("Test should not fail");
        assert!(formatted.contains("service1"));
        assert!(formatted.contains("running"));
        assert!(formatted.contains("service2"));
        assert!(formatted.contains("stopped"));
    }

    #[test]
    fn test_plain_output_format() {
        let data = serde_json::json!("Simple message");

        let formatted = OutputFormat::Plain
            .format_output(&data)
            .expect("Test should not fail");
        assert_eq!(formatted.trim(), "Simple message");
    }

    #[test]
    fn test_invalid_json_handling() {
        let invalid_data = Value::Null;

        let result = OutputFormat::Json.format_output(&invalid_data);
        assert!(result.is_ok()); // Should handle null gracefully
    }
}
