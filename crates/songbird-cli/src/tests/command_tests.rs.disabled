}

#[cfg(test)]
mod discovery_tests {

    #[tokio::test]
    async fn test_discovery_scan() {
        let _context = CliTestContext::new().expect("Failed to create test context");

        let result = discovery::execute_discovery(discovery::DiscoveryCommand::Scan {
            timeout: Some(5),
            format: crate::cli::OutputFormat::Table,
        })
        .await;

        // Discovery should handle network scanning gracefully
        assert!(result.is_ok() || result.is_err());
    }

    #[tokio::test]
    async fn test_discovery_list() {
        let _context = CliTestContext::new().expect("Failed to create test context");

        let result = discovery::execute_discovery(discovery::DiscoveryCommand::List {
            filter: None,
            format: crate::cli::OutputFormat::Json,
        })
        .await;

        assert!(result.is_ok() || result.is_err());
    }
}

#[cfg(test)]
mod config_tests {

    #[tokio::test]
    async fn test_config_show() {
        let context = CliTestContext::new().expect("Failed to create test context");

        let result = config::execute_config(config::ConfigCommand::Show {
            format: crate::cli::OutputFormat::Yaml,
            config_path: Some(context.config_path.clone()),
        })
        .await;

        assert!(result.is_ok());
    }

    #[tokio::test]
    async fn test_config_validate() {
        let context = CliTestContext::new().expect("Failed to create test context");

        let result = config::execute_config(config::ConfigCommand::Validate {
            config_path: Some(context.config_path.clone()),
        })
        .await;

        assert!(result.is_ok());
    }
}

#[cfg(test)]
mod gaming_tests {

    #[tokio::test]
    async fn test_gaming_scan() {
        let _context = CliTestContext::new().expect("Failed to create test context");

        let result = gaming::execute_gaming(gaming::GamingCommand::Scan {
            port_range: None,
            protocol: None,
            timeout: Some(5),
        })
        .await;

        // Gaming scan should handle network operations gracefully
        assert!(result.is_ok() || result.is_err());
    }

    #[tokio::test]
    async fn test_gaming_optimize() {
        let _context = CliTestContext::new().expect("Failed to create test context");

        let result = gaming::execute_gaming(gaming::GamingCommand::Optimize {
            game: Some("test-game".to_string()),
            auto: true,
        })
        .await;

        assert!(result.is_ok() || result.is_err());
    }
}

