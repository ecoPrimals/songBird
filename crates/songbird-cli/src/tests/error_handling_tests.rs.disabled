//! CLI Error Handling Tests
//!
//! Tests for CLI error handling, user-friendly error messages, and recovery

use super::*;
use crate::cli::errors::CliError;

#[cfg(test)]
mod error_handling_tests {

    #[test]
    fn test_cli_error_display() {
        let error = CliError::ConfigurationError("Invalid port".to_string());
        let display = format!("{error}");
        assert!(display.contains("Configuration error"));
        assert!(display.contains("Invalid port"));
    }

    #[test]
    fn test_cli_error_from_songbird_error() {
        let songbird_error = SongbirdError::configuration_error("Missing required field", None);
        let cli_error = CliError::from(songbird_error);

        match cli_error {
            CliError::ConfigurationError(msg) => {
                assert!(msg.contains("Missing required field"));
            }
            other => {
                eprintln!("Expected ConfigurationError, got: {:?}", other);
                assert!(false, "Expected ConfigurationError");
            }
        }
    }

    #[test]
    fn test_user_friendly_error_messages() {
        let errors = vec![
            CliError::NetworkError("Connection refused".to_string()),
            CliError::ConfigurationError("File not found".to_string()),
            CliError::ValidationError("Invalid format".to_string()),
            CliError::PermissionError("Access denied".to_string()),
        ];

        for error in errors {
            let message = error.user_friendly_message();
            assert!(!message.is_empty());
            assert!(!message.contains("Error:")); // Should be clean, user-friendly
        }
    }

    #[test]
    fn test_error_suggestions() {
        let error = CliError::ConfigurationError("Port 8080 already in use".to_string());
        let suggestions = error.get_suggestions();

        assert!(!suggestions.is_empty());
        assert!(suggestions.iter().any(|s| s.contains("different port")));
    }

    #[test]
    fn test_error_exit_codes() {
        assert_eq!(CliError::NetworkError("test".to_string()).exit_code(), 2);
        assert_eq!(
            CliError::ConfigurationError("test".to_string()).exit_code(),
            3
        );
        assert_eq!(CliError::ValidationError("test".to_string()).exit_code(), 4);
        assert_eq!(CliError::PermissionError("test".to_string()).exit_code(), 5);
    }

    #[test]
    fn test_error_recovery_hints() {
        let error = CliError::NetworkError("Connection timeout".to_string());
        let recovery = error.recovery_hint();

        assert!(recovery.is_some());
        let hint = recovery.expect("Test should not fail");
        assert!(hint.contains("retry") || hint.contains("network"));
    }

    #[test]
    fn test_cli_error_chain() {
        let root_cause = std::io::Error::new(std::io::ErrorKind::NotFound, "File not found");
        let songbird_error =
            SongbirdError::io_error("Failed to read config", Some(Box::new(root_cause)));
        let cli_error = CliError::from(songbird_error);

        // Should preserve error chain for debugging
        let debug_output = format!("{:?}", cli_error);
        assert!(debug_output.contains("File not found"));
    }

    #[test]
    fn test_error_context_preservation() {
        let error = CliError::ConfigurationError("Invalid YAML syntax at line 42".to_string());
        let formatted = error.format_for_terminal();

        assert!(formatted.contains("line 42"));
        assert!(formatted.contains("YAML"));
        // Should include helpful formatting for terminal display
    }
}
