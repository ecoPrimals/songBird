//! Integration tests for federation migration
//!
//! This test suite validates that the migration from old federation system
//! to new discovery-based approach works correctly end-to-end.

use songbird_discovery::{
    discovery::{DiscoveryConfig, ServiceDiscoveryFactory},
    federation_aware_discovery::{FederationAwareDiscovery, FederationDiscoveryConfig},
    migration::{
        FederationMigrationHelper, LegacyFederationConfig, LegacyFederationMode,
        LegacyFederationWrapper, LegacySovereigntyLevel, MigrationConfig,
    },
};
use std::collections::HashMap;
use std::time::Duration;
use tracing_test::traced_test;

/// Test basic configuration migration
#[tokio::test]
async fn test_basic_config_migration() {
    let legacy_config = LegacyFederationConfig {
        cluster_name: Some("test-cluster".to_string()),
        peer_discovery_enabled: true,
        discovery_endpoints: vec!["localhost:8080".to_string(), "localhost:8081".to_string()],
        heartbeat_interval: Duration::from_secs(30),
        sovereignty_level: Some(LegacySovereigntyLevel::High),
        enable_network_effects: true,
        federation_mode: Some(LegacyFederationMode::Peer),
        legacy_settings: HashMap::new(),
    };

    let mut migration_helper = FederationMigrationHelper::default();
    let new_config = migration_helper.migrate_config(legacy_config).unwrap();

    // Verify migration results
    assert!(new_config.enable_federation_patterns);
    assert!(new_config.enable_sovereignty_assessment);
    assert!(new_config.enable_network_effects);
    assert!(new_config.base_config.enable_network_scan);

    // Verify ports were extracted correctly
    assert!(new_config.base_config.scan_ports.contains(&8080));
    assert!(new_config.base_config.scan_ports.contains(&8081));

    // Verify statistics
    let stats = migration_helper.get_stats();
    assert_eq!(stats.configs_migrated, 1);
    assert!(stats.total_migration_time.as_millis() > 0);
}

/// Test migration with deprecated features
#[tokio::test]
async fn test_deprecated_feature_migration() {
    let mut legacy_settings = HashMap::new();
    legacy_settings.insert("deprecated_setting".to_string(), "value".to_string());

    let legacy_config = LegacyFederationConfig {
        cluster_name: Some("deprecated-test".to_string()),
        peer_discovery_enabled: true,
        discovery_endpoints: vec!["localhost:8080".to_string()],
        heartbeat_interval: Duration::from_millis(100), // Very fast heartbeat
        sovereignty_level: Some(LegacySovereigntyLevel::Complete),
        enable_network_effects: true,
        federation_mode: Some(LegacyFederationMode::Leader), // Deprecated!
        legacy_settings,
    };

    let mut migration_helper = FederationMigrationHelper::default();
    let migration_result = migration_helper.migrate_with_validation(legacy_config).await.unwrap();

    // Should succeed but with warnings
    assert!(migration_result.success);
    assert!(!migration_result.warnings.is_empty());

    // Should warn about leader mode
    let leader_warning = migration_result
        .warnings
        .iter()
        .any(|w| w.contains("Leader federation mode is deprecated"));
    assert!(leader_warning);

    // Should warn about legacy settings
    let legacy_setting_warning =
        migration_result.warnings.iter().any(|w| w.contains("Legacy setting"));
    assert!(legacy_setting_warning);
}

/// Test complete migration with validation
#[traced_test]
#[tokio::test]
async fn test_complete_migration_with_validation() {
    let legacy_config = LegacyFederationConfig {
        cluster_name: Some("validation-test".to_string()),
        peer_discovery_enabled: true,
        discovery_endpoints: vec!["localhost:8080".to_string()],
        heartbeat_interval: Duration::from_secs(30),
        sovereignty_level: Some(LegacySovereigntyLevel::High),
        enable_network_effects: true,
        federation_mode: Some(LegacyFederationMode::Peer),
        legacy_settings: HashMap::new(),
    };

    let mut migration_helper = FederationMigrationHelper::new(MigrationConfig {
        verbose_logging: true,
        validate_migration: true,
        migration_timeout: Duration::from_secs(30),
        preserve_legacy_behavior: false,
    });

    let migration_result = migration_helper.migrate_with_validation(legacy_config).await.unwrap();

    // Should succeed (even if no services are found in test environment)
    assert!(migration_result.success);

    // Should have performance comparison
    assert!(migration_result.performance_comparison.is_some());
    let perf = migration_result.performance_comparison.unwrap();
    assert!(perf.discovery_time_improvement >= 0.0);
    assert!(perf.memory_usage_improvement > 0.0);
    assert!(perf.feature_parity_score > 0.0);

    // Should have statistics
    assert_eq!(migration_result.stats.configs_migrated, 1);
}

/// Test legacy federation wrapper compatibility
#[tokio::test]
async fn test_legacy_wrapper_compatibility() {
    let config = FederationDiscoveryConfig::default();
    let mut wrapper = LegacyFederationWrapper::new(config).await.unwrap();

    // Test legacy API methods
    let peers_result = wrapper.discover_peers().await;
    // Should not error (even if no peers found)
    assert!(peers_result.is_ok());

    let network_effects_result = wrapper.get_network_effects().await;
    assert!(network_effects_result.is_ok());

    let join_result = wrapper.join_network("test-network").await;
    assert!(join_result.is_ok());
}

/// Test migration helper statistics tracking
#[tokio::test]
async fn test_migration_statistics() {
    let mut migration_helper = FederationMigrationHelper::default();

    // Migrate multiple configurations
    let configs = vec![
        create_simple_config("cluster-1"),
        create_simple_config("cluster-2"),
        create_simple_config("cluster-3"),
    ];

    for config in configs {
        migration_helper.migrate_config(config).unwrap();
    }

    let stats = migration_helper.get_stats();
    assert_eq!(stats.configs_migrated, 3);
    assert!(stats.total_migration_time.as_millis() > 0);

    // Reset stats
    migration_helper.reset_stats();
    let reset_stats = migration_helper.get_stats();
    assert_eq!(reset_stats.configs_migrated, 0);
}

/// Test endpoint parsing and network extraction
#[tokio::test]
async fn test_endpoint_parsing() {
    let legacy_config = LegacyFederationConfig {
        cluster_name: Some("endpoint-test".to_string()),
        peer_discovery_enabled: true,
        discovery_endpoints: vec![
            "localhost:8080".to_string(),
            "192.168.1.100:8443".to_string(),
            "10.0.0.50:3000".to_string(),
            "cluster-node:5000".to_string(),
        ],
        heartbeat_interval: Duration::from_secs(30),
        sovereignty_level: None,
        enable_network_effects: false,
        federation_mode: Some(LegacyFederationMode::Peer),
        legacy_settings: HashMap::new(),
    };

    let mut migration_helper = FederationMigrationHelper::default();
    let new_config = migration_helper.migrate_config(legacy_config).unwrap();

    // Verify ports were extracted
    assert!(new_config.base_config.scan_ports.contains(&8080));
    assert!(new_config.base_config.scan_ports.contains(&8443));
    assert!(new_config.base_config.scan_ports.contains(&3000));
    assert!(new_config.base_config.scan_ports.contains(&5000));

    // Verify networks were extracted
    assert!(new_config.base_config.scan_networks.contains(&"127.0.0.0/8".to_string()));
    assert!(new_config.base_config.scan_networks.contains(&"192.168.0.0/16".to_string()));
    assert!(new_config.base_config.scan_networks.contains(&"10.0.0.0/8".to_string()));
}

/// Test federation-aware discovery with migrated config
#[tokio::test]
async fn test_federation_discovery_with_migrated_config() {
    let legacy_config = create_simple_config("discovery-test");

    let mut migration_helper = FederationMigrationHelper::default();
    let new_config = migration_helper.migrate_config(legacy_config).unwrap();

    // Create federation-aware discovery with migrated config
    let base_discovery =
        songbird_discovery::discovery::UniversalDiscoveryFactory::create_for_config(
            &new_config.base_config,
        )
        .await
        .unwrap();
    let mut federation_discovery = FederationAwareDiscovery::new(base_discovery, new_config);

    // Test discovery functionality
    let services_result = federation_discovery.discover_federation_aware_services().await;
    assert!(services_result.is_ok());

    let services = services_result.unwrap();
    // In test environment, may not find services, but should not error

    // Test network effects calculation
    let network_potential = federation_discovery.calculate_network_effect_potential(&services);
    assert!(network_potential >= 0.0);
}

/// Test quick migration convenience functions
#[tokio::test]
async fn test_quick_migration_functions() {
    let legacy_config = create_simple_config("quick-test");

    // Test quick migration
    let new_config = FederationMigrationHelper::quick_migrate(legacy_config.clone()).unwrap();
    assert!(new_config.enable_federation_patterns);

    // Test quick migration with wrapper
    let wrapper =
        FederationMigrationHelper::quick_migrate_with_wrapper(legacy_config).await.unwrap();
    // Should create wrapper successfully
    drop(wrapper); // Just verify it was created
}

/// Test error handling in migration
#[tokio::test]
async fn test_migration_error_handling() {
    // Test with invalid configuration (empty endpoints)
    let invalid_config = LegacyFederationConfig {
        cluster_name: None,
        peer_discovery_enabled: true,
        discovery_endpoints: vec![], // Empty endpoints
        heartbeat_interval: Duration::from_secs(30),
        sovereignty_level: None,
        enable_network_effects: false,
        federation_mode: None,
        legacy_settings: HashMap::new(),
    };

    let mut migration_helper = FederationMigrationHelper::default();

    // Should still succeed (will use defaults)
    let result = migration_helper.migrate_config(invalid_config);
    assert!(result.is_ok());

    let new_config = result.unwrap();
    // Should have default ports
    assert!(!new_config.base_config.scan_ports.is_empty());
}

/// Test migration with large configuration
#[tokio::test]
async fn test_large_config_migration() {
    let mut legacy_settings = HashMap::new();
    for i in 0..1000 {
        legacy_settings.insert(format!("setting_{}", i), format!("value_{}", i));
    }

    let mut discovery_endpoints = Vec::new();
    for i in 0..100 {
        discovery_endpoints.push(format!("node-{}:808{}", i, i % 10));
    }

    let large_config = LegacyFederationConfig {
        cluster_name: Some("large-cluster-test".to_string()),
        peer_discovery_enabled: true,
        discovery_endpoints,
        heartbeat_interval: Duration::from_millis(50),
        sovereignty_level: Some(LegacySovereigntyLevel::Complete),
        enable_network_effects: true,
        federation_mode: Some(LegacyFederationMode::Peer),
        legacy_settings,
    };

    let mut migration_helper = FederationMigrationHelper::default();
    let start_time = std::time::Instant::now();

    let new_config = migration_helper.migrate_config(large_config).unwrap();
    let migration_time = start_time.elapsed();

    // Should complete quickly even with large config
    assert!(migration_time.as_millis() < 100);

    // Should have extracted many ports
    assert!(new_config.base_config.scan_ports.len() >= 10);

    // Should have extracted networks
    assert!(!new_config.base_config.scan_networks.is_empty());
}

/// Test concurrent migration operations
#[tokio::test]
async fn test_concurrent_migrations() {
    use tokio::task::JoinSet;

    let mut join_set = JoinSet::new();

    // Spawn multiple concurrent migration tasks
    for i in 0..10 {
        let config = create_simple_config(&format!("concurrent-{}", i));
        join_set.spawn(async move {
            let mut helper = FederationMigrationHelper::default();
            helper.migrate_config(config)
        });
    }

    // Wait for all migrations to complete
    let mut successful_migrations = 0;
    while let Some(result) = join_set.join_next().await {
        let migration_result = result.unwrap();
        if migration_result.is_ok() {
            successful_migrations += 1;
        }
    }

    // All migrations should succeed
    assert_eq!(successful_migrations, 10);
}

/// Test wrapper caching behavior
#[tokio::test]
async fn test_wrapper_caching() {
    let config = FederationDiscoveryConfig::default();
    let mut wrapper = LegacyFederationWrapper::new(config).await.unwrap();

    // First call should trigger discovery
    let start_time = std::time::Instant::now();
    let peers1 = wrapper.discover_peers().await.unwrap();
    let first_call_time = start_time.elapsed();

    // Second call should use cache (should be faster)
    let start_time = std::time::Instant::now();
    let peers2 = wrapper.discover_peers().await.unwrap();
    let second_call_time = start_time.elapsed();

    // Results should be the same
    assert_eq!(peers1.len(), peers2.len());

    // Second call should be faster (cached)
    // Note: In test environment this might not be measurable, so we just verify it doesn't error
    assert!(second_call_time.as_millis() >= 0);
}

// Helper functions

fn create_simple_config(cluster_name: &str) -> LegacyFederationConfig {
    LegacyFederationConfig {
        cluster_name: Some(cluster_name.to_string()),
        peer_discovery_enabled: true,
        discovery_endpoints: vec!["localhost:8080".to_string()],
        heartbeat_interval: Duration::from_secs(30),
        sovereignty_level: Some(LegacySovereigntyLevel::High),
        enable_network_effects: true,
        federation_mode: Some(LegacyFederationMode::Peer),
        legacy_settings: HashMap::new(),
    }
}
