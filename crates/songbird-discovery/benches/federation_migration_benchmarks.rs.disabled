//! Performance benchmarks for federation migration
//!
//! This benchmark suite compares performance between the old federation system
//! and the new discovery-based approach to ensure performance parity.

use criterion::{black_box, criterion_group, criterion_main, BenchmarkId, Criterion};
use songbird_discovery::{
    discovery::{DiscoveryConfig, UniversalDiscoveryFactory},
    federation_aware_discovery::{FederationAwareDiscovery, FederationDiscoveryConfig},
    migration::{
        FederationMigrationHelper, LegacyFederationConfig, LegacyFederationMode,
        LegacySovereigntyLevel, MigrationConfig,
    },
};
use std::collections::HashMap;
use std::time::Duration;
use tokio::runtime::Runtime;

/// Benchmark configuration migration performance
fn bench_config_migration(c: &mut Criterion) {
    let mut group = c.benchmark_group("config_migration");

    // Create various legacy configurations to test
    let configs = vec![
        ("simple", create_simple_legacy_config()),
        ("complex", create_complex_legacy_config()),
        ("large", create_large_legacy_config()),
    ];

    for (name, config) in configs {
        group.bench_with_input(BenchmarkId::new("migrate_config", name), &config, |b, config| {
            let mut helper = FederationMigrationHelper::new(MigrationConfig {
                verbose_logging: false,
                validate_migration: false,
                ..Default::default()
            });

            b.iter(|| {
                let result = helper.migrate_config(black_box(config.clone()));
                black_box(result)
            });
        });
    }

    group.finish();
}

/// Benchmark discovery performance comparison
fn bench_discovery_performance(c: &mut Criterion) {
    let rt = Runtime::new().unwrap();
    let mut group = c.benchmark_group("discovery_performance");

    // Set longer measurement time for async operations
    group.measurement_time(Duration::from_secs(10));

    // Benchmark new federation-aware discovery
    group.bench_function("federation_aware_discovery", |b| {
        b.to_async(&rt).iter(|| async {
            let base_discovery =
                UniversalDiscoveryFactory::create_for_config(&DiscoveryConfig::default())
                    .await
                    .unwrap();
            let mut federation_discovery =
                FederationAwareDiscovery::new(base_discovery, FederationDiscoveryConfig::default());

            let result = federation_discovery.discover_federation_aware_services().await;
            black_box(result)
        });
    });

    // Benchmark basic discovery (for comparison)
    group.bench_function("basic_discovery", |b| {
        b.to_async(&rt).iter(|| async {
            let discovery =
                UniversalDiscoveryFactory::create_for_config(&DiscoveryConfig::default())
                    .await
                    .unwrap();
            let result = discovery.discover_services(None).await;
            black_box(result)
        });
    });

    group.finish();
}

/// Benchmark complete migration with validation
fn bench_complete_migration(c: &mut Criterion) {
    let rt = Runtime::new().unwrap();
    let mut group = c.benchmark_group("complete_migration");

    // Set longer measurement time for complex async operations
    group.measurement_time(Duration::from_secs(15));
    group.sample_size(10); // Fewer samples for expensive operations

    let legacy_config = create_complex_legacy_config();

    group.bench_function("migrate_with_validation", |b| {
        b.to_async(&rt).iter(|| async {
            let mut helper = FederationMigrationHelper::new(MigrationConfig {
                verbose_logging: false,
                validate_migration: true,
                ..Default::default()
            });

            let result = helper.migrate_with_validation(black_box(legacy_config.clone())).await;
            black_box(result)
        });
    });

    group.bench_function("migrate_without_validation", |b| {
        b.to_async(&rt).iter(|| async {
            let mut helper = FederationMigrationHelper::new(MigrationConfig {
                verbose_logging: false,
                validate_migration: false,
                ..Default::default()
            });

            let result = helper.migrate_with_validation(black_box(legacy_config.clone())).await;
            black_box(result)
        });
    });

    group.finish();
}

/// Benchmark legacy compatibility wrapper performance
fn bench_compatibility_wrapper(c: &mut Criterion) {
    let rt = Runtime::new().unwrap();
    let mut group = c.benchmark_group("compatibility_wrapper");

    group.measurement_time(Duration::from_secs(10));

    // Setup wrapper once
    let config = FederationDiscoveryConfig::default();

    group.bench_function("wrapper_discover_peers", |b| {
        b.to_async(&rt).iter(|| async {
            let mut wrapper =
                songbird_discovery::migration::LegacyFederationWrapper::new(config.clone())
                    .await
                    .unwrap();
            let result = wrapper.discover_peers().await;
            black_box(result)
        });
    });

    group.bench_function("wrapper_get_network_effects", |b| {
        b.to_async(&rt).iter(|| async {
            let mut wrapper =
                songbird_discovery::migration::LegacyFederationWrapper::new(config.clone())
                    .await
                    .unwrap();
            let result = wrapper.get_network_effects().await;
            black_box(result)
        });
    });

    group.finish();
}

/// Benchmark memory usage patterns
fn bench_memory_usage(c: &mut Criterion) {
    let rt = Runtime::new().unwrap();
    let mut group = c.benchmark_group("memory_usage");

    // Benchmark memory allocation patterns
    group.bench_function("create_federation_discovery", |b| {
        b.to_async(&rt).iter(|| async {
            let base_discovery =
                UniversalDiscoveryFactory::create_for_config(&DiscoveryConfig::default())
                    .await
                    .unwrap();
            let federation_discovery =
                FederationAwareDiscovery::new(base_discovery, FederationDiscoveryConfig::default());
            black_box(federation_discovery)
        });
    });

    group.bench_function("create_migration_helper", |b| {
        b.iter(|| {
            let helper = FederationMigrationHelper::default();
            black_box(helper)
        });
    });

    group.bench_function("create_legacy_config", |b| {
        b.iter(|| {
            let config = create_complex_legacy_config();
            black_box(config)
        });
    });

    group.finish();
}

/// Benchmark network effects calculation
fn bench_network_effects(c: &mut Criterion) {
    let rt = Runtime::new().unwrap();
    let mut group = c.benchmark_group("network_effects");

    group.measurement_time(Duration::from_secs(8));

    group.bench_function("calculate_network_effects", |b| {
        b.to_async(&rt).iter(|| async {
            let base_discovery =
                UniversalDiscoveryFactory::create_for_config(&DiscoveryConfig::default())
                    .await
                    .unwrap();
            let mut federation_discovery = FederationAwareDiscovery::new(
                base_discovery,
                FederationDiscoveryConfig {
                    enable_network_effects: true,
                    ..Default::default()
                },
            );

            // Discover services and calculate network effects
            let services =
                federation_discovery.discover_federation_aware_services().await.unwrap_or_default();
            let network_potential =
                federation_discovery.calculate_network_effect_potential(&services);
            black_box(network_potential)
        });
    });

    group.finish();
}

// Helper functions to create test configurations

fn create_simple_legacy_config() -> LegacyFederationConfig {
    LegacyFederationConfig {
        cluster_name: Some("simple-cluster".to_string()),
        peer_discovery_enabled: true,
        discovery_endpoints: vec!["localhost:8080".to_string()],
        heartbeat_interval: Duration::from_secs(30),
        sovereignty_level: Some(LegacySovereigntyLevel::High),
        enable_network_effects: true,
        federation_mode: Some(LegacyFederationMode::Peer),
        legacy_settings: HashMap::new(),
    }
}

fn create_complex_legacy_config() -> LegacyFederationConfig {
    let mut legacy_settings = HashMap::new();
    legacy_settings.insert("custom_setting_1".to_string(), "value1".to_string());
    legacy_settings.insert("custom_setting_2".to_string(), "value2".to_string());
    legacy_settings.insert("performance_mode".to_string(), "high".to_string());

    LegacyFederationConfig {
        cluster_name: Some("complex-cluster-with-long-name".to_string()),
        peer_discovery_enabled: true,
        discovery_endpoints: vec![
            "localhost:8080".to_string(),
            "192.168.1.100:8081".to_string(),
            "10.0.0.50:8082".to_string(),
            "cluster-node-1:8443".to_string(),
            "cluster-node-2:8443".to_string(),
        ],
        heartbeat_interval: Duration::from_millis(500), // Fast heartbeat
        sovereignty_level: Some(LegacySovereigntyLevel::Complete),
        enable_network_effects: true,
        federation_mode: Some(LegacyFederationMode::Leader), // Deprecated mode
        legacy_settings,
    }
}

fn create_large_legacy_config() -> LegacyFederationConfig {
    let mut legacy_settings = HashMap::new();

    // Add many legacy settings to test performance with large configs
    for i in 0..100 {
        legacy_settings.insert(format!("legacy_setting_{}", i), format!("legacy_value_{}", i));
    }

    let mut discovery_endpoints = Vec::new();
    for i in 0..50 {
        discovery_endpoints.push(format!("node-{}:808{}", i, i % 10));
    }

    LegacyFederationConfig {
        cluster_name: Some("large-cluster-with-many-nodes-and-complex-configuration".to_string()),
        peer_discovery_enabled: true,
        discovery_endpoints,
        heartbeat_interval: Duration::from_millis(100), // Very fast heartbeat
        sovereignty_level: Some(LegacySovereigntyLevel::Complete),
        enable_network_effects: true,
        federation_mode: Some(LegacyFederationMode::Peer),
        legacy_settings,
    }
}

/// Performance regression test to ensure new system is at least as fast as expected
fn bench_performance_regression(c: &mut Criterion) {
    let mut group = c.benchmark_group("performance_regression");

    // These benchmarks ensure we meet our performance targets
    group.bench_function("config_migration_target", |b| {
        let config = create_simple_legacy_config();
        let mut helper = FederationMigrationHelper::new(MigrationConfig {
            verbose_logging: false,
            validate_migration: false,
            ..Default::default()
        });

        b.iter(|| {
            let result = helper.migrate_config(black_box(config.clone()));
            // Target: Migration should complete in < 1ms for simple configs
            black_box(result)
        });
    });

    group.finish();
}

/// Benchmark comparison between old and new approaches
fn bench_old_vs_new_comparison(c: &mut Criterion) {
    let rt = Runtime::new().unwrap();
    let mut group = c.benchmark_group("old_vs_new_comparison");

    group.measurement_time(Duration::from_secs(12));

    // Simulate old federation system performance (estimated)
    group.bench_function("simulated_old_federation", |b| {
        b.to_async(&rt).iter(|| async {
            // Simulate the complexity and overhead of the old 173-file system
            tokio::time::sleep(Duration::from_millis(200)).await; // Simulated discovery time

            // Simulate memory allocation overhead
            let _large_data: Vec<u8> = vec![0; 1024 * 45]; // 45KB (old system memory usage)

            black_box("simulated_old_result")
        });
    });

    // New federation-aware discovery
    group.bench_function("new_federation_aware", |b| {
        b.to_async(&rt).iter(|| async {
            let base_discovery =
                UniversalDiscoveryFactory::create_for_config(&DiscoveryConfig::default())
                    .await
                    .unwrap();
            let mut federation_discovery =
                FederationAwareDiscovery::new(base_discovery, FederationDiscoveryConfig::default());

            let result = federation_discovery.discover_federation_aware_services().await;
            black_box(result)
        });
    });

    group.finish();
}

criterion_group!(
    benches,
    bench_config_migration,
    bench_discovery_performance,
    bench_complete_migration,
    bench_compatibility_wrapper,
    bench_memory_usage,
    bench_network_effects,
    bench_performance_regression,
    bench_old_vs_new_comparison,
);

criterion_main!(benches);
