    #[tokio::test]
    async fn test_service_discovery_and_registration() {
        let config = DiscoveryConfig {
            node_id: "discovery_test".to_string(),
            federation_endpoints: vec!["http://localhost:8080".to_string()],
            discovery_interval: Duration::from_secs(30),
            cache_ttl: Duration::from_secs(300),
            max_retries: 3,
        };

        let mut discovery = FederatedDiscovery::new(config);

        // Register a service
        let service_metadata = HashMap::from([
            ("name".to_string(), "test_service".to_string()),
            ("version".to_string(), "1.0.0".to_string()),
            ("endpoint".to_string(), "http://localhost:9000".to_string()),
            ("capabilities".to_string(), "compute,storage".to_string()),
        ]);

        let registration_result = discovery.register_service(service_metadata).await;
        assert!(registration_result.is_ok());

        // Discover services
        let discovered_services = discovery.discover_services("test_service").await;
        assert!(discovered_services.is_ok());

        let services = discovered_services.unwrap();
        assert!(!services.is_empty());
    }

