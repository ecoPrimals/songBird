        };

        let gossip = GossipProtocol::new(config);
        assert!(gossip.is_active());
        assert_eq!(gossip.get_node_id(), "gossip_node1");
    }

    #[tokio::test]
    async fn test_gossip_message_propagation() {
        let mut gossip_nodes = vec![];

        for i in 0..5 {
            let config = GossipConfig {
                node_id: format!("gossip_node{}", i),
                gossip_interval: Duration::from_millis(50),
                fanout: 2,
                max_message_age: Duration::from_secs(60),
                compression_enabled: false,
            };
            gossip_nodes.push(GossipProtocol::new(config));
        }

        // Connect nodes to each other
        for i in 0..gossip_nodes.len() {
            for j in 0..gossip_nodes.len() {
                if i != j {
                    let peer_id = format!("gossip_node{}", j);
                    gossip_nodes[i]
                        .add_peer(peer_id)
                        .await
                        .expect("Should add peer");
                }
            }
        }

        // Send a gossip message from first node
        let message = GossipMessage {
            id: "test_message_1".to_string(),
            sender: "gossip_node0".to_string(),
            content: b"Hello, federation!".to_vec(),
            timestamp: SystemTime::now(),
            ttl: 10,
        };

        gossip_nodes[0]
            .broadcast_message(message)
            .await
            .expect("Should broadcast message");

        // Allow time for propagation
        sleep(Duration::from_millis(200)).await;

        // Verify message received by other nodes
        for i in 1..gossip_nodes.len() {
            let messages = gossip_nodes[i].get_received_messages().await;
            assert!(
                !messages.is_empty(),
                "Node {} should have received messages",
                i
            );
        }
    }

