    #[tokio::test]
    async fn test_auth_token_management() {
        let config = AuthConfig {
            auth_method: "jwt".to_string(),
            token_expiry: Duration::from_secs(1800),
            refresh_threshold: Duration::from_secs(300),
            max_auth_retries: 2,
            trusted_cas: vec![],
        };

        let mut auth = FederationAuth::new(config);

        // Generate auth token
        let token_result = auth.generate_token("test_federation", "test_node").await;
        assert!(token_result.is_ok());

        let token = token_result.unwrap();
        assert!(!token.token.is_empty());
        assert!(token.expires_at > SystemTime::now());

        // Validate token
        let validation_result = auth.validate_token(&token.token).await;
        assert!(validation_result.is_ok());
        assert!(validation_result.unwrap());
    }

    // Test Module 12: Trust Management
    #[tokio::test]
    async fn test_trust_manager_creation() {
        let config = TrustConfig {
            initial_trust_level: TrustLevel::Medium,
            trust_decay_rate: 0.01,
            trust_update_interval: Duration::from_secs(300),
            min_trust_threshold: 0.3,
            max_trust_level: 1.0,
        };

        let trust_manager = TrustManager::new(config);
        assert!(trust_manager.is_initialized());
    }

    #[tokio::test]
    async fn test_trust_level_management() {
        let config = TrustConfig {
            initial_trust_level: TrustLevel::Medium,
            trust_decay_rate: 0.005,
            trust_update_interval: Duration::from_secs(60),
            min_trust_threshold: 0.2,
            max_trust_level: 1.0,
        };

        let mut trust_manager = TrustManager::new(config);

        // Add trusted entities
        trust_manager
            .add_entity("trusted_node1", TrustLevel::High)
            .await
            .expect("Should add trusted entity");
        trust_manager
            .add_entity("new_node", TrustLevel::Low)
            .await
            .expect("Should add new entity");

        // Update trust based on behavior
        trust_manager
            .record_positive_interaction("new_node")
            .await
            .expect("Should record positive interaction");
        trust_manager
            .record_negative_interaction("trusted_node1")
            .await
            .expect("Should record negative interaction");

        // Check trust levels
        let new_node_trust = trust_manager.get_trust_level("new_node").await;
        let trusted_node_trust = trust_manager.get_trust_level("trusted_node1").await;

        assert!(new_node_trust.is_ok());
        assert!(trusted_node_trust.is_ok());

        // New node should have increased trust, trusted node should have decreased
        assert!(new_node_trust.unwrap() > TrustLevel::Low);
    }

    // Test Module 13: Error Handling and Edge Cases
    #[tokio::test]
    async fn test_raft_with_network_partition() {
        let config = RaftConfig {
            node_id: "isolated_node".to_string(),
            cluster_size: 3,
            election_timeout: Duration::from_millis(100),
            heartbeat_interval: Duration::from_millis(30),
            max_log_entries: 1000,
        };

        let node = RaftNode::new(config);

        // Simulate network partition by starting election without peers
        let election_result = node.start_election().await;
        assert!(election_result.is_ok());

        // Should remain in candidate state due to no majority
        sleep(Duration::from_millis(150)).await;
        let state = node.get_state().await;
        assert!(matches!(state, NodeState::Candidate | NodeState::Follower));
    }

    #[tokio::test]
    async fn test_gossip_with_message_loops() {
        let config = GossipConfig {
            node_id: "loop_test_node".to_string(),
            gossip_interval: Duration::from_millis(50),
            fanout: 1,
            max_message_age: Duration::from_millis(200), // Short TTL
            compression_enabled: false,
        };

        let mut gossip = GossipProtocol::new(config);

        // Add self as peer to create potential loop
        gossip
            .add_peer("loop_test_node".to_string())
            .await
            .expect("Should add self as peer");

        // Send message that could loop
        let message = GossipMessage {
            id: "loop_message".to_string(),
            sender: "loop_test_node".to_string(),
            content: b"Loop test".to_vec(),
            timestamp: SystemTime::now(),
            ttl: 5,
        };

        let broadcast_result = gossip.broadcast_message(message).await;
        assert!(broadcast_result.is_ok());

        // Should handle loop prevention gracefully
        sleep(Duration::from_millis(100)).await;
        let messages = gossip.get_received_messages().await;

        // Should not cause infinite loops
        assert!(messages.len() < 10);
    }

    #[tokio::test]
    async fn test_peer_manager_connection_failures() {
        let config = PeerConfig {
            max_peers: 3,
            connection_timeout: Duration::from_millis(10), // Very short timeout
            heartbeat_interval: Duration::from_secs(30),
            peer_discovery_interval: Duration::from_secs(60),
            max_connection_retries: 1,
        };

        let mut peer_manager = PeerManager::new(config);

        // Add peer with unreachable address
        let unreachable_peer = PeerInfo {
            id: "unreachable_peer".to_string(),
            address: SocketAddr::new(IpAddr::V4(Ipv4Addr::new(192, 0, 2, 1)), 9999), // RFC5737 test address
            status: PeerStatus::Disconnected,
            last_seen: SystemTime::now(),
            capabilities: vec!["test".to_string()],
            trust_score: 0.5,
            metadata: HashMap::new(),
        };

        let add_result = peer_manager.add_peer(unreachable_peer).await;
        assert!(add_result.is_ok()); // Should add but fail to connect

        // Attempt connection should fail gracefully
        let connect_result = peer_manager.connect_to_peer("unreachable_peer").await;
        assert!(connect_result.is_err());
    }

    // Test Module 14: Performance and Concurrency
    #[tokio::test]
    async fn test_concurrent_raft_operations() {
        let config = RaftConfig {
            node_id: "concurrent_node".to_string(),
            cluster_size: 1,
            election_timeout: Duration::from_millis(100),
            heartbeat_interval: Duration::from_millis(30),
            max_log_entries: 1000,
        };

        let node = RaftNode::new(config);

        // Perform concurrent operations
        let mut handles = vec![];
        for i in 0..10 {
            let node_clone = node.clone();
            let handle = tokio::spawn(async move {
                let entry = LogEntry {
                    term: 1,
                    index: i + 1,
                    command: format!("SET key{} value{}", i, i).into_bytes(),
                    timestamp: SystemTime::now(),
                };
                node_clone.append_log_entry(entry).await
            });
            handles.push(handle);
        }

        // Wait for all operations
        let mut successful_operations = 0;
        for handle in handles {
            let result = handle.await.expect("Task should complete");
            if result.is_ok() {
                successful_operations += 1;
            }
        }

        assert!(successful_operations > 0);
    }

    #[tokio::test]
    async fn test_gossip_performance_under_load() {
        let config = GossipConfig {
            node_id: "performance_node".to_string(),
            gossip_interval: Duration::from_millis(10),
            fanout: 2,
            max_message_age: Duration::from_secs(60),
            compression_enabled: true,
        };

        let gossip = GossipProtocol::new(config);

        // Add multiple peers
        for i in 0..5 {
            let peer_id = format!("peer{}", i);
            gossip.add_peer(peer_id).await.expect("Should add peer");
        }

        // Send many messages rapidly
        let start = Instant::now();
        for i in 0..50 {
            let message = GossipMessage {
                id: format!("perf_message_{}", i),
                sender: "performance_node".to_string(),
                content: format!("Performance test message {}", i).into_bytes(),
                timestamp: SystemTime::now(),
                ttl: 10,
            };

            let _ = gossip.broadcast_message(message).await;
        }
        let duration = start.elapsed();

        // Should handle rapid message sending efficiently
        assert!(duration < Duration::from_millis(500));
    }

    #[tokio::test]
    async fn test_federation_integration_workflow() {
        // Create a mini federation with multiple components
        let raft_config = RaftConfig {
            node_id: "integration_raft".to_string(),
            cluster_size: 1,
            election_timeout: Duration::from_millis(100),
            heartbeat_interval: Duration::from_millis(30),
            max_log_entries: 100,
        };

        let gossip_config = GossipConfig {
            node_id: "integration_gossip".to_string(),
            gossip_interval: Duration::from_millis(50),
            fanout: 2,
            max_message_age: Duration::from_secs(30),
            compression_enabled: false,
        };

        let discovery_config = DiscoveryConfig {
            node_id: "integration_discovery".to_string(),
            federation_endpoints: vec!["http://localhost:8080".to_string()],
            discovery_interval: Duration::from_secs(30),
            cache_ttl: Duration::from_secs(300),
            max_retries: 2,
        };

        // Initialize components
        let raft_node = RaftNode::new(raft_config);
        let gossip_protocol = GossipProtocol::new(gossip_config);
        let mut federated_discovery = FederatedDiscovery::new(discovery_config);

        // Start raft election
        raft_node
            .start_election()
            .await
            .expect("Should start election");

        // Register service through discovery
        let service_metadata = HashMap::from([
            ("name".to_string(), "integration_service".to_string()),
            ("endpoint".to_string(), "http://localhost:9000".to_string()),
        ]);

        let registration_result = federated_discovery.register_service(service_metadata).await;
        assert!(registration_result.is_ok());

        // Send gossip message
        let gossip_message = GossipMessage {
            id: "integration_message".to_string(),
            sender: "integration_gossip".to_string(),
            content: b"Integration test successful".to_vec(),
            timestamp: SystemTime::now(),
            ttl: 10,
        };

        let gossip_result = gossip_protocol.broadcast_message(gossip_message).await;
        assert!(gossip_result.is_ok());

        // Verify all components are functioning
        assert!(raft_node.get_state().await != NodeState::Failed);
        assert!(gossip_protocol.is_active());
        assert!(federated_discovery.is_active());
    }
}
