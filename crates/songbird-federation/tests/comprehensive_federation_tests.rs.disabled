    #[tokio::test]
    async fn test_service_mesh_node_management() {
        let config = MeshConfig {
            mesh_id: "node_management_mesh".to_string(),
            max_nodes: 10,
            heartbeat_interval: Duration::from_secs(30),
            failure_detection_timeout: Duration::from_secs(90),
            routing_algorithm: "shortest_path".to_string(),
        };

        let mut mesh = ServiceMesh::new(config);

        // Add service nodes
        let node1 = ServiceNode {
            id: "service_node1".to_string(),
            address: SocketAddr::new(IpAddr::V4(Ipv4Addr::new(192, 168, 1, 10)), 8080),
            capabilities: vec!["compute".to_string(), "storage".to_string()],
            health_score: 0.95,
            last_heartbeat: SystemTime::now(),
            metadata: HashMap::new(),
        };

        let node2 = ServiceNode {
            id: "service_node2".to_string(),
            address: SocketAddr::new(IpAddr::V4(Ipv4Addr::new(192, 168, 1, 11)), 8080),
            capabilities: vec!["networking".to_string()],
            health_score: 0.88,
            last_heartbeat: SystemTime::now(),
            metadata: HashMap::new(),
        };

        mesh.add_node(node1).await.expect("Should add node1");
        mesh.add_node(node2).await.expect("Should add node2");

        assert_eq!(mesh.get_node_count().await, 2);

