    #[tokio::test]
    async fn test_peer_lifecycle_management() {
        let config = PeerConfig {
            max_peers: 5,
            connection_timeout: Duration::from_secs(10),
            heartbeat_interval: Duration::from_secs(30),
            peer_discovery_interval: Duration::from_secs(60),
            max_connection_retries: 2,
        };

        let mut peer_manager = PeerManager::new(config);

        // Add peers
        let peer1 = PeerInfo {
            id: "peer1".to_string(),
            address: SocketAddr::new(IpAddr::V4(Ipv4Addr::new(192, 168, 1, 20)), 8080),
            status: PeerStatus::Connected,
            last_seen: SystemTime::now(),
            capabilities: vec!["federation".to_string(), "consensus".to_string()],
            trust_score: 0.9,
            metadata: HashMap::new(),
        };

        let peer2 = PeerInfo {
            id: "peer2".to_string(),
            address: SocketAddr::new(IpAddr::V4(Ipv4Addr::new(192, 168, 1, 21)), 8080),
            status: PeerStatus::Connecting,
            last_seen: SystemTime::now(),
            capabilities: vec!["replication".to_string()],
            trust_score: 0.85,
            metadata: HashMap::new(),
        };

        peer_manager
            .add_peer(peer1)
            .await
            .expect("Should add peer1");
        peer_manager
            .add_peer(peer2)
            .await
            .expect("Should add peer2");

        assert_eq!(peer_manager.get_peer_count().await, 2);

        // Test peer status updates
        peer_manager
            .update_peer_status("peer2", PeerStatus::Connected)
            .await
            .expect("Should update peer status");

        let peer2_info = peer_manager.get_peer_info("peer2").await;
        assert!(peer2_info.is_ok());
        assert_eq!(peer2_info.unwrap().status, PeerStatus::Connected);
    }

