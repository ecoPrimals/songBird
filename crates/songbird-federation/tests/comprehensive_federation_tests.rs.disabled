    #[tokio::test]
    async fn test_state_synchronization_process() {
        let config = SyncConfig {
            sync_interval: Duration::from_secs(10),
            batch_size: 50,
            compression_enabled: false,
            conflict_resolution: "timestamp".to_string(),
            max_sync_retries: 2,
        };

        let mut state_sync = StateSync::new(config);

        // Add sync peers
        let peers = vec![
            "sync_peer1.example.com:8080".to_string(),
