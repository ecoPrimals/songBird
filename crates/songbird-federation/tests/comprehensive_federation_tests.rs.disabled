    // Test Module 7: Gossip Protocol
    #[tokio::test]
    async fn test_gossip_protocol_creation() {
        let config = GossipConfig {
            node_id: "gossip_node1".to_string(),
            gossip_interval: Duration::from_millis(100),
            fanout: 3,
            max_message_age: Duration::from_secs(60),
