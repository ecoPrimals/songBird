    // Test Module 4: Leader Election
    #[tokio::test]
    async fn test_leader_election_creation() {
        let config = ElectionConfig {
            node_id: "election_node1".to_string(),
            cluster_size: 3,
            election_timeout: Duration::from_millis(500),
            heartbeat_interval: Duration::from_millis(100),
            priority: 1,
        };

        let election = LeaderElection::new(config);
        assert_eq!(election.get_state().await, LeadershipState::Follower);
    }

    #[tokio::test]
    async fn test_leader_election_process() {
        let mut elections = vec![];

        for i in 0..3 {
            let config = ElectionConfig {
                node_id: format!("election_node{}", i),
                cluster_size: 3,
                election_timeout: Duration::from_millis(400 + i * 50),
                heartbeat_interval: Duration::from_millis(80),
                priority: i as u8, // Different priorities
            };
            elections.push(LeaderElection::new(config));
        }

        // Start elections
        for election in &elections {
            election
                .start_election()
                .await
                .expect("Should start election");
        }

        // Wait for election completion
        sleep(Duration::from_millis(600)).await;

        // Verify leadership
        let mut leaders = 0;
        for election in &elections {
            if election.get_state().await == LeadershipState::Leader {
                leaders += 1;
            }
        }

        assert_eq!(leaders, 1, "Should have exactly one leader");
    }

