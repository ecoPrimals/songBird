//! Production Federation Tests
//!
//! Comprehensive tests for federation functionality covering real-world scenarios.

use songbird_errors::FederationResult;
use songbird_federation::{
    canonical::{CanonicalFederationManager, FederationHealth, FederationMode, FederationStatus},
    encrypted_snapshots::{EncryptedSnapshotManager, SnapshotType},
};
use std::time::Duration;
use tokio::time::timeout;

#[tokio::test]
async fn test_federation_manager_initialization() -> FederationResult<()> {
    let manager = CanonicalFederationManager::new().await?;

    // Test initial state
    let status = manager.get_federation_status().await?;
    assert_eq!(status.mode, FederationMode::Standalone);
    assert!(status.connected_peers.is_empty());

    Ok(())
}

#[tokio::test]
async fn test_federation_node_discovery() -> FederationResult<()> {
    let manager = CanonicalFederationManager::new().await?;

    // Test node discovery functionality
    let discovered_nodes = manager.discover_nodes().await?;

    // Should complete without errors (may return empty list in test environment)
    assert!(discovered_nodes.len() >= 0);

    Ok(())
}

#[tokio::test]
async fn test_federation_health_monitoring() -> FederationResult<()> {
    let manager = CanonicalFederationManager::new().await?;

    // Test health monitoring
    let health = manager.get_federation_health().await?;

    // Verify health structure
    assert!(health.total_nodes >= 0);
    assert!(health.online_nodes <= health.total_nodes);
    assert!(health.consensus_health >= 0.0 && health.consensus_health <= 1.0);

    Ok(())
}

#[tokio::test]
async fn test_federation_mode_transitions() -> FederationResult<()> {
    let mut manager = CanonicalFederationManager::new().await?;

    // Test mode transitions
    manager.set_mode(FederationMode::Peer).await?;
    let status = manager.get_federation_status().await?;
    assert_eq!(status.mode, FederationMode::Peer);

    manager.set_mode(FederationMode::Leader).await?;
    let status = manager.get_federation_status().await?;
    assert_eq!(status.mode, FederationMode::Leader);

    Ok(())
}

#[tokio::test]
async fn test_encrypted_snapshot_creation() -> FederationResult<()> {
    let snapshot_manager = EncryptedSnapshotManager::new().await?;

    // Test snapshot creation
    let test_data = b"test federation data";
    let snapshot = snapshot_manager
        .create_snapshot(test_data.to_vec(), SnapshotType::Federation)
        .await?;

    // Verify snapshot properties
    assert!(!snapshot.encrypted_data.is_empty());
    assert!(snapshot.metadata.size > 0);
    assert_eq!(snapshot.metadata.snapshot_type, SnapshotType::Federation);

    Ok(())
}

#[tokio::test]
async fn test_federation_performance_under_load() -> FederationResult<()> {
    let manager = CanonicalFederationManager::new().await?;

    // Test multiple concurrent operations
    let mut handles = Vec::new();

    for i in 0..10 {
        let manager_clone = manager.clone();
        let handle = tokio::spawn(async move {
            let node_id = format!("test-node-{}", i);
            manager_clone.register_node(&node_id).await
        });
        handles.push(handle);
    }

    // Wait for all operations to complete
    for handle in handles {
        let result = timeout(Duration::from_secs(5), handle).await;
        assert!(
            result.is_ok(),
            "Federation operation should complete within timeout"
        );
    }

    Ok(())
}

#[tokio::test]
async fn test_federation_error_handling() -> FederationResult<()> {
    let manager = CanonicalFederationManager::new().await?;

    // Test error handling with invalid operations
    let result = manager.connect_to_peer("invalid://endpoint").await;
    assert!(result.is_err(), "Should handle invalid endpoint gracefully");

    // Test graceful degradation
    let health = manager.get_federation_health().await?;
    assert!(
        health.consensus_health >= 0.0,
        "Health should remain valid even with errors"
    );

    Ok(())
}

#[tokio::test]
async fn test_federation_cleanup_and_shutdown() -> FederationResult<()> {
    let manager = CanonicalFederationManager::new().await?;

    // Register some test nodes
    manager.register_node("test-node-1").await?;
    manager.register_node("test-node-2").await?;

    // Test cleanup
    manager.cleanup().await?;

    // Verify clean state
    let status = manager.get_federation_status().await?;
    assert!(status.connected_peers.is_empty() || status.connected_peers.len() <= 2);

    Ok(())
}

#[tokio::test]
async fn test_federation_snapshot_encryption_security() -> FederationResult<()> {
    let snapshot_manager = EncryptedSnapshotManager::new().await?;

    // Test with sensitive data
    let sensitive_data = b"sensitive federation configuration data";
    let snapshot = snapshot_manager
        .create_snapshot(sensitive_data.to_vec(), SnapshotType::Configuration)
        .await?;

    // Verify encryption (encrypted data should be different from original)
    assert_ne!(snapshot.encrypted_data, sensitive_data.to_vec());
    assert!(snapshot.encrypted_data.len() > 0);

    // Test decryption
    let decrypted = snapshot_manager.decrypt_snapshot(&snapshot).await?;
    assert_eq!(decrypted, sensitive_data.to_vec());

    Ok(())
}

#[tokio::test]
async fn test_federation_concurrent_access() -> FederationResult<()> {
    let manager = CanonicalFederationManager::new().await?;

    // Test concurrent read/write operations
    let read_handle = {
        let manager_clone = manager.clone();
        tokio::spawn(async move {
            for _ in 0..50 {
                let _ = manager_clone.get_federation_status().await;
                tokio::task::yield_now().await;
            }
        })
    };

    let write_handle = {
        let manager_clone = manager.clone();
        tokio::spawn(async move {
            for i in 0..25 {
                let node_id = format!("concurrent-node-{}", i);
                let _ = manager_clone.register_node(&node_id).await;
                tokio::task::yield_now().await;
            }
        })
    };

    // Wait for both to complete
    let (read_result, write_result) = tokio::join!(read_handle, write_handle);
    assert!(read_result.is_ok(), "Concurrent reads should succeed");
    assert!(write_result.is_ok(), "Concurrent writes should succeed");

    Ok(())
}
