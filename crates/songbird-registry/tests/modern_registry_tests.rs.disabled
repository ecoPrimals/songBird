//! Modern Registry Tests - Canonical Implementation
//!
//! This module tests the registry functionality using current APIs
//! and canonical patterns.

use songbird_errors::{Result as SongbirdResult, SongbirdError, SongbirdResponse};
use songbird_discovery::traits::service::{ServiceInfo, UniversalService};
use songbird_registry::{
    health::{HealthCheckPolicy, HealthCheckType, HealthFailureAction, HealthMonitor},
    service::{DynUniversalService, ServiceRegistry},
};
use std::collections::HashMap;
use std::sync::Arc;
use std::time::Duration;
use tokio::sync::RwLock;

/// Mock service implementation for testing
pub struct MockTestService {
    pub service_id: String,
    pub endpoint: String,
    pub healthy: Arc<RwLock<bool>>,
}

impl MockTestService {
    pub fn new(service_id: String, endpoint: String) -> Self {
        Self {
            service_id,
            endpoint,
            healthy: Arc::new(RwLock::new(true)),
        }
    }

    pub async fn set_healthy(&self, healthy: bool) {
        *self.healthy.write().await = healthy;
    }
}

#[async_trait::async_trait]
impl UniversalService for MockTestService {
    type Error = SongbirdError;

    fn service_info(&self) -> ServiceInfo {
        ServiceInfo {
            service_id: self.service_id.clone(),
            name: format!("Test Service {}", self.service_id),
            version: "1.0.0".to_string(),
            endpoint: self.endpoint.clone(),
            capabilities: vec!["test".to_string()],
            metadata: HashMap::new(),
        }
    }

    async fn start(&mut self) -> Result<(), Self::Error> {
        tracing::info!("Starting test service: {}", self.service_id);
        Ok(())
    }

    async fn stop(&mut self) -> Result<(), Self::Error> {
        tracing::info!("Stopping test service: {}", self.service_id);
        Ok(())
    }

    async fn health_check(&self) -> Result<serde_json::Value, Self::Error> {
        let is_healthy = *self.healthy.read().await;
        Ok(serde_json::json!({
            "status": if is_healthy { "healthy" } else { "unhealthy" },
            "service_id": self.service_id,
            "timestamp": chrono::Utc::now().to_rfc3339()
        }))
    }
}

