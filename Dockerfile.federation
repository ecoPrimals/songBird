# Songbird Federation Service Dockerfile
# Pure Rust implementation for self-contained federation

FROM rust:1.70-slim as builder

# Install dependencies for building
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY crates ./crates

# Build the federation binary
RUN cargo build --release --bin songbird-federation

# Runtime stage
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create songbird user
RUN groupadd -r songbird && useradd -r -g songbird songbird

# Create directories
RUN mkdir -p /var/lib/songbird/federation \
    /var/log/songbird \
    /etc/songbird

# Copy the binary
COPY --from=builder /app/target/release/songbird-federation /usr/local/bin/

# Copy configuration templates
COPY config/federation.toml /etc/songbird/federation.toml

# Set permissions
RUN chown -R songbird:songbird /var/lib/songbird /var/log/songbird /etc/songbird

# Switch to songbird user
USER songbird

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

# Expose ports
EXPOSE 8000 8001 8002

# Default command
CMD ["songbird-federation", "--config", "/etc/songbird/federation.toml"] 