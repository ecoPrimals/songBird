# BearDog License Validator Service
# Validates commercial licensing for Songbird Orchestrator "Biome Edge" services

FROM rust:1.75-slim-bullseye AS builder

# Install dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Create a minimal Rust project for the license validator
RUN cargo init --name beardog-validator

# Copy license validator source
COPY docker/beardog-validator/Cargo.toml ./Cargo.toml
COPY docker/beardog-validator/src ./src

# Build the validator
RUN cargo build --release

# Runtime image
FROM debian:bullseye-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create validator user
RUN groupadd -r validator && useradd -r -g validator validator

# Copy the built binary
COPY --from=builder /app/target/release/beardog-validator /usr/local/bin/beardog-validator

# Copy configuration files
COPY docker/beardog-validator/config/ /etc/beardog/

# Set up directories
RUN mkdir -p /var/log/beardog /var/lib/beardog && \
    chown -R validator:validator /var/log/beardog /var/lib/beardog

# Switch to validator user
USER validator

# Environment variables
ENV BEARDOG_CONFIG_PATH=/etc/beardog/validator.toml
ENV BEARDOG_LOG_LEVEL=info
ENV BEARDOG_VALIDATION_INTERVAL=300

# Health check
HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
    CMD beardog-validator health || exit 1

# Start the license validator
CMD ["beardog-validator", "run"] 